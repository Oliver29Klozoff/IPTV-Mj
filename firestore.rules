rules_version = '2';

// Phase 1 Firestore rules for mktv-apk.
//
// Deploying this file changes only users/{uid} and codes/{code}.
// cast_sessions, watch_parties, playback_sessions, community_health events,
// and rewatch_notes notes stay on the behavior of the deployed ruleset
// 49be0297-4176-46e6-8cfb-5e536c688ffc (updated 2026-09-20): any signed-in
// client can read and write them, and read includes list. The stricter cast
// rules are in git at d8b3aa6 and are not part of this phase.
//
// There is no catch-all deny. Production does not have one, and adding one
// would reject any path this file does not name.
//
// Test first — firestore-tests/rules.test.js
// Deploy:  firebase deploy --only firestore:rules --project mktv-apk

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── unchanged from the deployed ruleset ─────────────────────────────────
    match /cast_sessions/{code} {
      allow read, write: if request.auth != null;
    }

    match /watch_parties/{code} {
      allow read, write: if request.auth != null;
    }

    match /playback_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Parents are not writable in production. Only the documents the app queries are.
    match /community_health/{providerHostHash}/events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /rewatch_notes/{contentKey}/notes/{noteId} {
      allow read, write: if request.auth != null;
    }

    // ─── pairing code: first 8 characters of the anonymous uid ───────────────
    // Knowing the code is enough to read the pointer. It is not enough to write it.
    // v7.24 publishes with set({uid}), which these rules accept.
    function codeOwner(shortCode) {
      return request.auth != null
        && request.auth.uid.size() >= 8
        && request.auth.uid.lower()[0:8] == shortCode
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid.size() <= 128;
    }

    function storedCodeMatches(shortCode) {
      return resource.data.keys().hasAll(['uid'])
        && resource.data.uid is string
        && resource.data.uid.size() >= 8
        && resource.data.uid.lower()[0:8] == shortCode;
    }

    match /codes/{shortCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if codeOwner(shortCode);
      // A missing uid must not error the rule, or a broken pointer cannot be reclaimed.
      // A second account that shares the prefix cannot take a pointer that already
      // matches. A pointer whose stored uid does not start with this code can.
      allow update: if codeOwner(shortCode)
        && ((resource.data.keys().hasAll(['uid']) && resource.data.uid == request.auth.uid)
            || !storedCodeMatches(shortCode));
      allow delete: if false;
    }

    // ─── sync library ────────────────────────────────────────────────────────
    function syncKeys() {
      return [
        'version', 'syncedAt', 'device',
        'favoriteChannelIds', 'favoriteCategoryIds', 'recentlyWatchedIds',
        'favoriteFolders', 'channelFolders', 'favoriteOrder',
        'vodProgress', 'seriesProgress', 'episodesWatched',
        'mergedFavorites', 'mergedFavoriteCategories',
        'mergedVodFavorites', 'mergedSeriesFavorites',
        'hiddenMergedVodCategories', 'hiddenMergedSeriesCategories'
      ];
    }

    function optList(data, key, max) {
      return !(key in data) || (data[key] is list && data[key].size() <= max);
    }

    function optMap(data, key, max) {
      return !(key in data) || (data[key] is map && data[key].size() <= max);
    }

    // Create has no legacy keys to preserve, so the whole document is checked.
    function syncShape(data) {
      return data.keys().hasOnly(syncKeys())
        && data.keys().size() >= 1
        && (!('version' in data) || (data.version is int && data.version == 1))
        && (!('syncedAt' in data) || (data.syncedAt is int && data.syncedAt > 0
              && data.syncedAt < 4102444800000))
        && (!('device' in data) || (data.device is string && data.device.size() <= 120))
        && optList(data, 'favoriteChannelIds', 20000)
        && optList(data, 'favoriteCategoryIds', 4000)
        && optList(data, 'recentlyWatchedIds', 100)
        && optList(data, 'favoriteFolders', 500)
        && optMap(data, 'channelFolders', 20000)
        && optList(data, 'favoriteOrder', 20000)
        && optMap(data, 'vodProgress', 20000)
        && optMap(data, 'seriesProgress', 20000)
        && optList(data, 'episodesWatched', 20000)
        && optList(data, 'mergedFavorites', 20000)
        && optList(data, 'mergedFavoriteCategories', 8000)
        && optList(data, 'mergedVodFavorites', 20000)
        && optList(data, 'mergedSeriesFavorites', 20000)
        && optList(data, 'hiddenMergedVodCategories', 8000)
        && optList(data, 'hiddenMergedSeriesCategories', 8000);
    }

    // affectedKeys() includes removed keys. Requiring it to be a subset of the
    // sync fields would reject the next release's set(), which deletes a legacy
    // key by leaving it out. Added and changed keys are the ones the client is
    // writing, and those have to be approved. A legacy key may stay or be removed.
    // It may not be added or given a new value.
    function touched(diff, key) {
      return diff.addedKeys().hasAny([key]) || diff.changedKeys().hasAny([key]);
    }

    function changedList(data, diff, key, max) {
      return !touched(diff, key) || (data[key] is list && data[key].size() <= max);
    }

    function changedMap(data, diff, key, max) {
      return !touched(diff, key) || (data[key] is map && data[key].size() <= max);
    }

    function syncChanges(data, diff) {
      return diff.addedKeys().hasOnly(syncKeys())
        && diff.changedKeys().hasOnly(syncKeys())
        && (!touched(diff, 'version') || (data.version is int && data.version == 1))
        && (!touched(diff, 'syncedAt') || (data.syncedAt is int && data.syncedAt > 0
              && data.syncedAt < 4102444800000))
        && (!touched(diff, 'device') || (data.device is string && data.device.size() <= 120))
        && changedList(data, diff, 'favoriteChannelIds', 20000)
        && changedList(data, diff, 'favoriteCategoryIds', 4000)
        && changedList(data, diff, 'recentlyWatchedIds', 100)
        && changedList(data, diff, 'favoriteFolders', 500)
        && changedMap(data, diff, 'channelFolders', 20000)
        && changedList(data, diff, 'favoriteOrder', 20000)
        && changedMap(data, diff, 'vodProgress', 20000)
        && changedMap(data, diff, 'seriesProgress', 20000)
        && changedList(data, diff, 'episodesWatched', 20000)
        && changedList(data, diff, 'mergedFavorites', 20000)
        && changedList(data, diff, 'mergedFavoriteCategories', 8000)
        && changedList(data, diff, 'mergedVodFavorites', 20000)
        && changedList(data, diff, 'mergedSeriesFavorites', 20000)
        && changedList(data, diff, 'hiddenMergedVodCategories', 8000)
        && changedList(data, diff, 'hiddenMergedSeriesCategories', 8000);
    }

    match /users/{uid} {
      // The other device reads this after it resolves the pairing code.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && syncShape(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && syncChanges(request.resource.data, request.resource.data.diff(resource.data));
      // The app never deletes a library. Sync removes a legacy key by replacing
      // the document, which is an update, not a delete.
      allow delete: if false;
    }
  }
}
