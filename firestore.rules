rules_version = '2';

// Firestore security rules for the mktv-apk project.
//
// Written after finding that an anonymous client could LIST /cast_sessions and read
// every document in it, including old ones still holding a plaintext stream URL from
// before casts were encrypted.
//
// The split between `get` and `list` is the whole point. `allow read` grants both.
// Granting list is what lets a stranger enumerate every active cast and walk off with
// the sealed boxes to crack offline at their leisure; with list denied, they must
// already know the session code — which IS the secret — before they can fetch
// anything, and guessing it becomes an online game against Firestore rather than an
// offline one against a GPU. That single change is worth far more than making the
// code longer.
//
// Collections here were taken from every `.collection("…")` in the app. Only
// community_health/*/events and rewatch_notes/*/notes are read as collections; every
// other access is by document id, so denying list on them costs nothing.
//
// NOTE: there is deliberately no catch-all `match /{document=**} { deny }` at the
// bottom. It is good practice, but a wrong deny silently breaks a feature, and these
// rules have not been exercised against the live app yet. Add it once you have
// confirmed nothing else touches Firestore.
//
// Test first — firestore-tests/rules.test.js runs these against the emulator, and the
// first version of this file failed it in four ways that would each have broken casting.
//
// Deploy:  firebase deploy --only firestore:rules --project mktv-apk
//          (or paste into Firebase console -> Firestore -> Rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── cast sessions ───────────────────────────────────────────────────────
    // One document per "Receive a cast" screen, holding `box`: the stream URL (and
    // optional channel pack and mini-guide) sealed to a key that only ever appeared
    // on the receiver's screen — the QR, or the typed code. The server never sees it.
    //
    // A session lives as long as someone is watching: the receiver polls it, and the
    // sender re-casts into it when changing channel. So the window below is a
    // viewing session, not a handshake. An earlier 30-minute window would have cut
    // live sessions off mid-evening — and the TV answers a denied read by signing in
    // anonymously again, so it would have minted a new Firebase account on every
    // poll, every 2.5 seconds, for as long as it stayed on.
    match /cast_sessions/{code} {

      // resource == null is a read of a document that doesn't exist yet. Both the TV
      // and the phone create a session by first reading a random code to check it is
      // free, expecting "not found" — without this clause that check is denied and no
      // session can ever be created. It reveals nothing: there is nothing there.
      allow get: if request.auth != null
                 && (resource == null
                     || request.time < resource.data.createdAt + duration.value(12, 'h'));
      allow list: if false;

      // Receiver creates the session; sender merges the sealed box in. Both are
      // anonymous clients with no owner to compare against — knowing the code is the
      // capability. The field allow-list and size cap stop the collection being used
      // as free storage by anyone who finds the project id.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['createdAt', 'updatedAt', 'box', 'url', 'title']);

      // senderVersion / packSize are written in the clear on every send for
      // diagnostics (see CastRelayManager.send) — they must be allowed or every cast
      // fails. The box cap sits under Firestore's 1 MiB document limit; a real pack
      // is ~28KB, or ~90KB with a mini-guide (200 channels, measured).
      allow update: if request.auth != null
                    && request.time < resource.data.createdAt + duration.value(12, 'h')
                    && request.resource.data.keys().hasOnly(
                         ['createdAt', 'updatedAt', 'box', 'url', 'title',
                          'senderVersion', 'packSize'])
                    && (!('box' in request.resource.data)
                        || (request.resource.data.box is string
                            && request.resource.data.box.size() < 900000));

      // Both ends delete when done. Anything missed becomes unreadable once the
      // window above passes.
      allow delete: if request.auth != null;
    }

    // ─── sync: phone -> TV favourites and watch state ────────────────────────
    // Same reasoning. The TV resolves codes/<code> to a uid and then reads that
    // user's document, so `get` has to stay open to any authenticated client — but
    // listing would hand over every sync code and every user's library at once.
    match /codes/{shortCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // ─── watch party / handoff ───────────────────────────────────────────────
    // Joined by knowing the party code; never enumerated.
    match /watch_parties/{party} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    match /playback_sessions/{session} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // ─── collections that are genuinely read as collections ──────────────────
    // These two ARE queried by the app (CommunityHealthManager orders and filters
    // events; RewatchNotesManager reads a content key's notes), so list must stay
    // allowed or those features break.
    match /community_health/{providerHash} {
      allow read, write: if request.auth != null;
      match /events/{event} {
        allow read, write: if request.auth != null;
      }
    }

    match /rewatch_notes/{contentKey} {
      allow read, write: if request.auth != null;
      match /notes/{note} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
