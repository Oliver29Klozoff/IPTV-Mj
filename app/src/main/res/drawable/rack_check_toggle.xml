<?xml version="1.0" encoding="utf-8"?>
<!-- The same toggle for settings that are CheckBoxes in code (Show Movies tab, AMOLED black …), as
     one drawable (track and knob together). Only what inflates: SettingsActivity.applyRackAccent
     swaps in rackToggleDrawable(), the identical shape in the user's accent or gradient, before
     the first frame. Cyan = the app's default accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/oled_cyan_primary" />
                    <corners android:radius="5dp" />
                    <size android:width="56dp" android:height="30dp" />
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="4dp"
                android:width="22dp" android:height="22dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF000000" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rack_control_off" />
                    <corners android:radius="5dp" />
                    <stroke android:width="1dp" android:color="@color/rack_control_edge" />
                    <size android:width="56dp" android:height="30dp" />
                </shape>
            </item>
            <item android:gravity="start|center_vertical" android:left="4dp"
                android:width="22dp" android:height="22dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rack_knob_off" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
