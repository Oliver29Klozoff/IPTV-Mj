<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Sidebar's buttons: the usual chip, with a heavier 3.5dp ring on remote focus so the
     focused button is plain from the sofa. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_focus_fill" />
            <corners android:radius="4dp" />
            <stroke android:width="3.5dp" android:color="@color/rack_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#99000000" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#80EDEDED" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#40EDEDED" />
        </shape>
    </item>
</selector>
