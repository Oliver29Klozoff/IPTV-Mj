<?xml version="1.0" encoding="utf-8"?>
<!-- Settings' text-input fields (EPG URL, pairing code) — forked from search_bg.xml rather than
     retinting it directly: that drawable is the real search-bar background shared by Home, TV
     Home, TV Recording, and the EPG timeline screen, all outside this reskin's scope.
     v6.79: a cyan outline while the field has focus, so it's clear where typing will go (and
     where D-pad focus is on a TV / car box). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_surface_background" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/oled_cyan_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_surface_background" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/oled_card_stroke" />
        </shape>
    </item>
</selector>
