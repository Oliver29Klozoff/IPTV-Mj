<?xml version="1.0" encoding="utf-8"?>
<!-- Settings' text-input fields (e.g. etEpgUrl) — forked from search_bg.xml rather than
     retinting it directly: that drawable is the real search-bar background shared by Home, TV
     Home, TV Recording, and the EPG timeline screen, all outside this reskin's scope. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/oled_surface_background" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/oled_outline_stroke" />
</shape>
