<?xml version="1.0" encoding="utf-8"?>
<!-- One segment (a RadioButton) of a segmented control. Only what inflates:
     SettingsActivity.applyRackAccent swaps in rackSegmentBackground() — the same states, with the
     chosen segment in the user's accent or gradient — before the first frame. Cyan = the app's
     default accent. The D-pad focus outline is the segment's foreground (rack_segment_focus.xml),
     so that swap never touches it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_focus_fill" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_pressed" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
