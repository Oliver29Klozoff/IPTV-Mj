<?xml version="1.0" encoding="utf-8"?>
<!-- Square-cornered toggle track (Studio Rack). The "on" track is drawn white on purpose:
     SettingsActivity.applyRackAccent tints it with the user's accent in MULTIPLY mode, which turns
     white into the accent and leaves the grey "off" track exactly as drawn. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="5dp" />
            <size android:width="56dp" android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_control_off" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="@color/rack_control_edge" />
            <size android:width="56dp" android:height="30dp" />
        </shape>
    </item>
</selector>
