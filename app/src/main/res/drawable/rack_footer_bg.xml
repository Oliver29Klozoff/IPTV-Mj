<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick bar pinned under every panel (Refresh EPG / Check update / Log out). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_footer" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_border" />
        </shape>
    </item>
</layer-list>
