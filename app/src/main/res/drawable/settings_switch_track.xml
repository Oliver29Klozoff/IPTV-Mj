<?xml version="1.0" encoding="utf-8"?>
<!-- Track for every Settings toggle — both the framework Switch (android:track) and SwitchMaterial
     (app:track, with useMaterialThemeColors off) use this same drawable so the two widget types
     look identical. Solid cyan when on; a dim pill when off; a cyan-glow outline under D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="24dp" />
        </shape>
    </item>
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/oled_text_primary" />
            <size android:width="40dp" android:height="24dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="24dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_surface_container_highest" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/oled_cyan_glow" />
            <size android:width="40dp" android:height="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_surface_container_highest" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/oled_outline_stroke" />
            <size android:width="40dp" android:height="24dp" />
        </shape>
    </item>
</selector>
