<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Home's viewing style cards: a 3.5dp ring on remote focus, a lighter 2dp edge on the
     style in use (activated), and a hairline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_focus_fill" />
            <corners android:radius="6dp" />
            <stroke android:width="3.5dp" android:color="@color/rack_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_pressed" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/rack_text_secondary" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_focus_fill" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/rack_text_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_surface" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/rack_border" />
        </shape>
    </item>
</selector>
