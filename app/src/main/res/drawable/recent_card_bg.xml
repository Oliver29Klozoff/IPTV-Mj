<?xml version="1.0" encoding="utf-8"?>
<!-- A Recent Channels card: flat with a dim navy edge at rest, a bright 3dp blue ring under the
     D-pad (the card also grows a little; RecentChannelsDrawer). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33008CFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#FF1A2C4A" />
                    <corners android:radius="10dp" />
                    <stroke android:width="3dp" android:color="#008CFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#99101C30" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="#253E66" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
