<?xml version="1.0" encoding="utf-8"?>
<!-- Home search field: a square-cornered well like Settings' text fields (forked from the shared
     search_bg.xml, which the guide and TV screens still use). Light 2dp edge while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_surface" />
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="@color/rack_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_surface" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/rack_control_edge" />
        </shape>
    </item>
</selector>
