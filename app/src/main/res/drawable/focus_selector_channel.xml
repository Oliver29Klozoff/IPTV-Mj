<?xml version="1.0" encoding="utf-8"?>
<!-- Cyan-retinted fork of focus_selector.xml, for the live-channel row only (item_channel.xml /
     item_merged_channel.xml). Forked rather than retinting the shared drawable directly because
     focus_selector.xml is also the focus ring for every VOD/Series/episode row app-wide — this
     reskin pass is scoped to Live TV, so those stay on the original blue accent for now. Same
     state logic and geometry as the original, colors only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#3306B6D4" />
            <stroke android:width="2dp" android:color="@color/oled_cyan_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#2206B6D4" />
            <stroke android:width="1dp" android:color="@color/oled_cyan_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
