<?xml version="1.0" encoding="utf-8"?>
<!-- Home sidebar tabs and bare icon buttons: nothing at rest, a ripple on touch, and the Settings
     focus look (lifted fill + light outline) under the D-pad. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rack_focus_fill" />
                    <corners android:radius="4dp" />
                    <stroke android:width="2dp" android:color="@color/rack_focus_ring" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
