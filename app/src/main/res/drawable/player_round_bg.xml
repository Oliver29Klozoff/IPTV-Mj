<?xml version="1.0" encoding="utf-8"?>
<!-- Player OSD (v6.93): round / pill transport buttons (back 30 s, LIVE) over video. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rack_focus_fill" />
            <corners android:radius="40dp" />
            <stroke android:width="2dp" android:color="@color/rack_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99000000" />
            <corners android:radius="40dp" />
            <stroke android:width="1dp" android:color="#59EDEDED" />
        </shape>
    </item>
</selector>
