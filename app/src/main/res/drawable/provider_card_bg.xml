<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Providers: one provider's sub-card. Since v6.79 these sit INSIDE the Providers
     card (the Stitch layout), so they use the recessed nested surface rather than the card
     surface itself — otherwise they'd be invisible against their own parent. Only used by
     SettingsActivity.updateServerList. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/oled_surface_nested" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/oled_card_stroke" />
</shape>
