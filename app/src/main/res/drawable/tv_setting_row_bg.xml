<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="false">
        <layer-list>
            <item><color android:color="#0E2038" /></item>
            <item android:width="4dp" android:gravity="start">
                <shape><solid android:color="#008CFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <color android:color="#0A1828" />
    </item>
    <item>
        <color android:color="#080E1A" />
    </item>
</selector>
