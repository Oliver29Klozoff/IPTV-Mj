<?xml version="1.0" encoding="utf-8"?>
<!-- Seek preview card: dark, a faint edge so it reads over any picture, the player's 4dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#E6080808" />
    <corners android:radius="4dp" />
    <stroke android:width="1dp" android:color="#59EDEDED" />
</shape>
