<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Peek panel over live video: near-opaque so text stays readable on bright pictures, with
     the rack's faint edge. No blur or shadow; it has to draw cheaply over playing video. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#EB080808" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/rack_border" />
</shape>
