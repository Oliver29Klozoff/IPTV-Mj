<?xml version="1.0" encoding="utf-8"?>
<!-- Background for Settings' radio-group "chips" — each RadioButton in the four FlowRadioGroups
     (auto-refresh schedule, stream format, video player, DNS provider). They're still real
     RadioButtons (same ids, same RadioGroup check listeners); only the round radio dot is
     replaced by this. state_checked, not state_selected: RadioButton drives checked, so a
     selected-based selector (as the Stitch spec wrote it) would never light up. Checked+focused
     keeps a visible ring so D-pad focus on the selected chip isn't hidden. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/oled_text_primary" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_cyan_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_focus_fill" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/oled_cyan_glow" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_focus_fill" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/oled_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oled_surface_nested" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/oled_card_stroke" />
        </shape>
    </item>
</selector>
