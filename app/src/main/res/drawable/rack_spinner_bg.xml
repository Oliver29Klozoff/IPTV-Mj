<?xml version="1.0" encoding="utf-8"?>
<!-- Audio / subtitle language dropdowns: the rack_input_bg well plus a chevron, so they read as
     pickers. A dark field is safe: the app forces night mode (IptvApplication), so the spinner's
     item text is always light. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rack_bg" />
                    <corners android:radius="4dp" />
                    <stroke android:width="2dp" android:color="@color/rack_focus_ring" />
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="12dp"
                android:width="18dp" android:height="18dp"
                android:drawable="@drawable/ic_settings_chevron_down" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/rack_bg" />
                    <corners android:radius="4dp" />
                    <stroke android:width="1dp" android:color="@color/rack_control_edge" />
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="12dp"
                android:width="18dp" android:height="18dp"
                android:drawable="@drawable/ic_settings_chevron_down" />
        </layer-list>
    </item>
</selector>
