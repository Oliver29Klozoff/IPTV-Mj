<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape variant — left nav sidebar, mini player left-centered, categories/channels on right.
    All IDs must match activity_home.xml exactly.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:background="#111111"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="14dp"
            android:paddingHorizontal="12dp"
            android:text="MKTV"
            android:textColor="#008CFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

        <Button
            android:id="@+id/landBtnFavorites"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="FAVORITES"
            android:textColor="#008CFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <!-- landBtnProviders no longer spans the full width — it used to overlap
                 landBtnRefreshProviders's small 32dp touch target underneath (both real
                 clickable Buttons stacked in the same FrameLayout), which on a car-box
                 touchscreen (less precise digitizer, often used with gloves/while driving)
                 could easily register a tap meant for refresh as a no-op tab reselect
                 instead, making refresh look like it does nothing. Explicit end margin keeps
                 its clickable bounds clear of the refresh button's real space. -->
            <Button
                android:id="@+id/landBtnProviders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="48dp"
                android:background="@android:color/transparent"
                android:text="PROVIDERS"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />

            <!-- The long-press-to-refresh gesture on landBtnProviders itself wasn't
                 discoverable at all — this gives landscape the same visible refresh icon
                 portrait already has next to search (btnRefreshProviders). Larger 44dp touch
                 target (was 32dp) for the same car-box-touchscreen-precision reason above —
                 the icon itself stays visually 32dp via padding. -->
            <ImageButton
                android:id="@+id/landBtnRefreshProviders"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/stat_notify_sync"
                android:tint="#4FC3F7"
                android:contentDescription="Refresh providers" />

        </FrameLayout>

        <Button
            android:id="@+id/landBtnLive"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="LIVE"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/landBtnCategories"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="CATEGORIES"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/landBtnMovies"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="MOVIES"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/landBtnSeries"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="SERIES"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/landBtnGuide"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="GUIDE"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/landBtnWatching"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="HISTORY"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="14dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" android:layout_marginTop="4dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp">
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#1E1E1E"
                android:hint="Search..."
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingStart="8dp"
                android:paddingEnd="36dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#888888"
                android:contentDescription="Clear search"
                android:visibility="gone" />
        </FrameLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="8dp">
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#AAAAAA"
                android:scaleType="center"
                android:contentDescription="Settings" />
            <Button
                android:id="@+id/btnSort"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="#1E1E1E"
                android:text="&#8645;"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Hidden views required by HomeActivity binding -->
        <Button android:id="@+id/btnHeroWatch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageButton android:id="@+id/btnFullscreen" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/ivHeroChannelLogo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>

    <!-- Sidebar divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#222222"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/topBar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENT AREA: mini player LEFT | categories+channels RIGHT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/topBar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MIDDLE: categories -->
        <LinearLayout
            android:id="@+id/categoriesColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <!-- PROVIDERS MODE ROW — landscape equivalent of the portrait row under tabLayout
                 (activity_home.xml). Portrait's rows never existed here, so switching to
                 landscape hid Movies/Series browsing entirely inside the Providers tab even
                 though the underlying ProvidersMode state/click-handling was already shared —
                 only the visual row was missing. Visibility driven by the same
                 providersModeRow/guideModeRow ids in setupTabs()'s tab-selected listener. -->
            <LinearLayout
                android:id="@+id/providersModeRow"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#1A1A1A"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnProvidersModeLive"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/focus_selector"
                    android:gravity="center"
                    android:text="Live"
                    android:textAllCaps="true"
                    android:textColor="#008CFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnProvidersModeMovies"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/focus_selector"
                    android:gravity="center"
                    android:text="Movies"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnProvidersModeSeries"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="@drawable/focus_selector"
                    android:gravity="center"
                    android:text="Series"
                    android:textAllCaps="true"
                    android:textColor="#888888"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- GUIDE MODE ROW — landscape equivalent of the portrait row (What's On/Grid). -->
            <LinearLayout
                android:id="@+id/guideModeRow"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="#1A1A1A"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnWhatsOnRow"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/focus_selector"
                    android:text="📋 What's On"
                    android:textColor="#008CFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnTimelineViewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/focus_selector"
                    android:text="⏱ Grid"
                    android:textColor="#008CFF"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnGuideRefreshRow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_popup_sync"
                    android:tint="#888888"
                    android:contentDescription="Refresh guide" />

            </LinearLayout>

            <!-- SYNC PROGRESS — landscape equivalent of portrait's syncProgressContainer, shown
                 while a large catalog (movies/series) is downloading. -->
            <LinearLayout
                android:id="@+id/syncProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/syncProgressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="#008CFF" />

            </LinearLayout>

            <!-- WHAT'S ON NOW — landscape equivalent of activity_home.xml's strip. See
                 HomeActivity.updateWhatsOnNowStrip's kdoc. -->
            <TextView
                android:id="@+id/tvWhatsOnNowHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:text="WHAT'S ON NOW"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWhatsOnNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#141414"
                android:paddingTop="8dp" />

            <!-- Drill-down replacement for rvCategories within the same column — tapping a
                 category (Live/Categories/Movies tabs) hides rvCategories and shows this
                 instead, in the same space; tapping the sidebar tab again goes back. Series/
                 History/Favorites/Guide (no categories) show this directly. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#141414"
                android:visibility="gone"
                android:paddingTop="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />

        </LinearLayout>

        <!-- Column divider -->
        <View
            android:id="@+id/categoriesDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#222222" />

        <!-- RIGHT: mini player on top, channels below -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/miniPlayerContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/miniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:use_controller="false" >

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/hero_gradient_scrim" />
                </androidx.media3.ui.PlayerView>

                <!-- Channel name + EPG overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvMiniChannelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMiniEpg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#BBBBBB"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />

                    <ProgressBar
                        android:id="@+id/miniEpgProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progressTint="#008CFF"
                        android:progressBackgroundTint="#333333" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnCollapsePip"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:text="PiP ▼"
                    android:textColor="#AAAAAA"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/miniPlayerProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#008CFF"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Genre filter chips ("All Sports" etc.) — landscape-only, stacked vertically to
             the right of the channel list instead of the horizontal scroll row used on
             portrait, so it doesn't eat into the categories column's height. -->
        <ScrollView
            android:id="@+id/genreFilterColumn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="#1A1A1A"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/genreChipContainerVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp"
                android:paddingHorizontal="6dp" />

        </ScrollView>

    </LinearLayout>

    <!-- BULK-SELECT BAR — landscape equivalent of activity_home.xml's bulkSelectBar. Was entirely
         missing from this layout, so every bulkSelectBar/btnBulkSelectDone/btnBulkSelectCancel
         reference in HomeActivity (all nullable view-binding lookups) silently no-opped in
         landscape — Done/Cancel never appeared during Favorites reorder or any bulk-select mode,
         with no way to confirm or back out short of leaving the screen. Overlaid across the
         content area (elevated, pinned to top, spanning from topBar's end to parent's end) rather
         than pushed into the vertical categoriesColumn flow, since it needs to stay visible and
         reachable regardless of which column/list is currently showing. -->
    <LinearLayout
        android:id="@+id/bulkSelectBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/topBar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBulkSelectCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnBulkSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Select All"
            android:textColor="#008CFF"
            android:textSize="12sp" />

        <!-- Providers' own Select All (Live/Movies/Series bulk-select there, separate from
             Favorites'/primary channels' btnBulkSelectAll above) — was entirely missing from
             this layout like the rest of this bar, so binding.btnProvidersSelectAll's three
             nullable references in HomeActivity silently no-opped in landscape. Placed on the
             same shared bar rather than squeezed into the already-tight 150dp sidebar tab row
             portrait puts it in (activity_home.xml has it inline next to the refresh icon,
             where there's no equivalent free space here). -->
        <TextView
            android:id="@+id/btnProvidersSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Select All"
            android:textColor="#008CFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnBulkSelectDone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Done"
            android:textColor="#34C759"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBulkSelectHide"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Hide"
            android:textColor="#FFA500"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnBulkSelectCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="✕"
            android:textColor="#FF6B6B"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Hidden views required by binding but not shown in landscape -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAVORITES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROVIDERS" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOVIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GUIDE" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORY" />
    </com.google.android.material.tabs.TabLayout>

    <TextView android:id="@+id/tvHeroDescription" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <!-- PiP corner overlay — real position/size now, matching portrait's shape (was previously
         a hidden 0x0 stub here, so the drag/resize/tap-to-restore floating box built for
         portrait was invisible/non-functional in landscape, the orientation the car-box/
         head-unit is always in). Bottom-right of the FULL screen (not just the content area
         right of the sidebar) — the sidebar is only ~150dp wide and left-anchored, so a
         220dp-wide box anchored to the parent's end still clears it with room to spare. The
         drag/resize logic in HomeActivity's setupPipCornerDragResize() already works against
         any layout, since it only reads/writes this view's layoutParams/translation — no code
         changes were needed, only this view's real bounds. -->
    <FrameLayout
        android:id="@+id/pipCorner"
        android:layout_width="220dp"
        android:layout_height="130dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:background="#000000"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/pipCornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#88000000"
            android:padding="4dp"
            android:id="@+id/tvPipChannelName"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btnPipRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="#AA000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="↩"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
