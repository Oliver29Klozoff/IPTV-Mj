<?xml version="1.0" encoding="utf-8"?>
<!-- Barlow as one family, so textStyle="bold" picks the real SemiBold face instead of
     synthesizing a fake bold. Used by the home screen's theme overlay (ThemeOverlay.HomeRack). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/barlow_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/barlow_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/barlow_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/barlow_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/barlow_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/barlow_semibold" app:fontStyle="normal" app:fontWeight="600" />
</font-family>
