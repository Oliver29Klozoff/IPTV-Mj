<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined grey buttons (Cancel, Edit, Saved codes, the Quick bar): see-through, lifted under
     D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/rack_focus_fill" />
    <item android:color="@android:color/transparent" />
</selector>
