<?xml version="1.0" encoding="utf-8"?>
<!-- Outline that only exists under D-pad focus — for buttons with no resting outline (danger,
     Back, the top bar's icon buttons). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/oled_cyan_glow" />
    <item android:color="@android:color/transparent" />
</selector>
