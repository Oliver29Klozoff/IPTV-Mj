<?xml version="1.0" encoding="utf-8"?>
<!-- Segment label. Black on a checked (accent) segment until applyRackAccent picks black or white
     for the user's actual accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="#FF000000" />
    <item android:state_enabled="false" android:color="@color/rack_disabled_text" />
    <item android:state_focused="true" android:color="@color/rack_text" />
    <item android:color="@color/rack_text_muted" />
</selector>
