<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRecStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_play"
        android:tint="#00CC66"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnShare"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_share"
        android:tint="#008CFF"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnRetry"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_popup_sync"
        android:tint="#FF8800"
        android:visibility="gone" />

    <!-- Trims the fixed ~20s pre-roll/post-roll padding off the file — see RecordingTrimmer
         kdoc. Only shown for DONE recordings, same visibility rule as btnPlay/btnShare. -->
    <ImageButton
        android:id="@+id/btnTrimPadding"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_crop"
        android:tint="#AAAAAA"
        android:contentDescription="Remove padding"
        android:visibility="gone" />

    <!-- Adds this recording to the user's Trakt collection (marked "owned", separate from
         watched-history) — only shown when Trakt is connected, since most users won't use it,
         and only for DONE recordings, same rule as btnPlay/btnShare/btnTrimPadding. -->
    <ImageButton
        android:id="@+id/btnTraktCollect"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_add"
        android:tint="#ED1C24"
        android:contentDescription="Add to Trakt collection"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#666666" />
</LinearLayout>
