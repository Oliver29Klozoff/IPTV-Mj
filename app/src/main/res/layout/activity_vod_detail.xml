<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:orientation="horizontal">

    <!-- Left: poster + play controls -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="#141414"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivVodCover"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="#222222" />

        <ProgressBar
            android:id="@+id/progressVod"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:progressTint="#008CFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#008CFF"
            android:text="▶  Play"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btnFavorite" />

        <!-- D-pad focus support (focusable + tv_sidebar_focus ring + explicit nextFocus chain)
             added to every button on this screen — previously none were focusable at all, so a
             D-pad simply couldn't move around here; only touch worked. -->
        <Button
            android:id="@+id/btnFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:background="@drawable/tv_sidebar_focus"
            android:backgroundTint="#222222"
            android:text="☆  Add to Favorites"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnPlay"
            android:nextFocusDown="@id/btnWatchTrailer" />

        <Button
            android:id="@+id/btnWatchTrailer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_sidebar_focus"
            android:backgroundTint="#222222"
            android:text="▶  Watch Trailer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnFavorite"
            android:nextFocusDown="@id/btnClearProgress" />

        <Button
            android:id="@+id/btnClearProgress"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_sidebar_focus"
            android:text="✕  Clear Progress"
            android:textAllCaps="false"
            android:textColor="#888888"
            android:textSize="13sp"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnWatchTrailer"
            android:nextFocusDown="@id/btnBack" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_sidebar_focus"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnClearProgress" />
    </LinearLayout>

    <!-- Right: details -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvVodTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVodRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="#FFD700"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvVodYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvVodDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvVodGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#008CFF"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminateTint="#008CFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVodPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#DDDDDD"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvVodCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvVodDirector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
