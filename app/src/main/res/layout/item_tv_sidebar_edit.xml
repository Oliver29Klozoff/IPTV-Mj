<?xml version="1.0" encoding="utf-8"?>
<!-- One sidebar entry in Customize Sidebar: a drag handle (touch screens), its name and state,
     then Move up, Move down and Shown/Hidden, all reachable with the remote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@color/rack_surface"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvSidebarHandle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="≡"
        android:textColor="@color/rack_text_secondary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvSidebarIcon"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/rack_text_secondary"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSidebarTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_semibold"
            android:maxLines="1"
            android:textColor="@color/rack_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSidebarDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rack_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSidebarUp"
        style="@style/SidebarEditChip"
        android:layout_width="48dp"
        android:text="▲" />

    <TextView
        android:id="@+id/btnSidebarDown"
        style="@style/SidebarEditChip"
        android:layout_width="48dp"
        android:text="▼" />

    <TextView
        android:id="@+id/btnSidebarVisible"
        style="@style/SidebarEditChip"
        android:layout_width="wrap_content"
        android:minWidth="104dp"
        android:paddingHorizontal="10dp" />

</LinearLayout>
