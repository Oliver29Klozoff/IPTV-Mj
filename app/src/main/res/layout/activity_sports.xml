<?xml version="1.0" encoding="utf-8"?>
<!-- Sports Now (v7.13): games on now and coming up, grouped by league (SportsActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnSportsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rack_row_bg"
            android:contentDescription="Back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_back"
            app:tint="@color/rack_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSportsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:letterSpacing="0.12"
                android:text="SPORTS NOW"
                android:textColor="@color/oled_cyan_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvSportsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow"
                android:text="Games on now and in the next 18 hours, from the guide"
                android:textColor="@color/rack_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search: filters the list by team, league, channel or score as you type. -->
    <EditText
        android:id="@+id/etSportsSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rack_row_bg"
        android:fontFamily="@font/barlow"
        android:hint="Search teams, leagues, channels"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/rack_text"
        android:textColorHint="@color/rack_text_muted"
        android:textSize="15sp" />

    <!-- The mini player and the list: stacked on a phone held upright, side by side in landscape
         (SportsActivity sets the orientation). -->
    <LinearLayout
        android:id="@+id/sportsBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sportsMiniPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/sportsMiniPlayer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#000000"
                android:focusable="true"
                android:contentDescription="Mini player. Select for full screen."
                app:use_controller="false"
                app:resize_mode="fit" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvSportsMiniTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow"
                    android:maxLines="2"
                    android:textColor="@color/rack_text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSportsFullScreen"
                    style="@style/Rack.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Full screen" />

                <ImageButton
                    android:id="@+id/btnSportsMiniClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/rack_row_bg"
                    android:contentDescription="Stop the mini player"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/rack_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sportsListPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/teamShortcutRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/teamShortcuts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSportsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow"
                android:gravity="center"
                android:padding="32dp"
                android:text="Looking for games…"
                android:textColor="@color/rack_text_secondary"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSports"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>