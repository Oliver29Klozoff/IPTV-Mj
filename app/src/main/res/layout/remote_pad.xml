<?xml version="1.0" encoding="utf-8"?>
<!-- Phone remote buttons (v7.19), laid out like the Shield remote: the round D-pad, then Back /
     Home / Play-Pause, then the CH and VOL rockers either side of Guide / Last / Mute. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <com.iptvapp.ui.remote.RemoteDpadView
        android:id="@+id/remoteDpad"
        android:layout_width="200dp"
        android:layout_height="200dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnKeyBack"
            style="@style/RemoteRoundKey"
            android:contentDescription="Back"
            android:src="@drawable/ic_player_back" />

        <ImageButton
            android:id="@+id/btnKeyHome"
            style="@style/RemoteRoundKey"
            android:contentDescription="Home"
            android:src="@drawable/ic_remote_home" />

        <ImageButton
            android:id="@+id/btnKeyPlayPause"
            style="@style/RemoteRoundKey"
            android:contentDescription="Play or pause"
            android:src="@drawable/ic_remote_playpause" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="@drawable/remote_rocker_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyChUp"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Channel up"
                android:text="+" />

            <TextView
                style="@style/RemoteRockerLabel"
                android:text="CH" />

            <TextView
                android:id="@+id/btnKeyChDown"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Channel down"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyGuide"
                style="@style/RemotePill"
                android:text="Guide" />

            <TextView
                android:id="@+id/btnKeyLast"
                style="@style/RemotePill"
                android:text="Last" />

            <TextView
                android:id="@+id/btnKeyMute"
                style="@style/RemotePill"
                android:text="Mute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="@drawable/remote_rocker_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyVolUp"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Volume up"
                android:text="+" />

            <TextView
                style="@style/RemoteRockerLabel"
                android:text="VOL" />

            <TextView
                android:id="@+id/btnKeyVolDown"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Volume down"
                android:text="−" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
