<?xml version="1.0" encoding="utf-8"?>
<!-- Phone remote buttons: Power, D-pad, Back / Home / Play, Full screen, then CH and VOL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <ImageButton
        android:id="@+id/btnKeyPower"
        style="@style/RemoteRoundKey"
        android:layout_marginBottom="@dimen/remote_row_gap"
        android:contentDescription="Power"
        android:src="@drawable/ic_remote_power"
        app:tint="@color/rack_danger_text" />

    <com.iptvapp.ui.remote.RemoteDpadView
        android:id="@+id/remoteDpad"
        android:layout_width="@dimen/remote_dpad_size"
        android:layout_height="@dimen/remote_dpad_size" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/remote_row_gap"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnKeyBack"
            style="@style/RemoteRoundKey"
            android:contentDescription="Back"
            android:src="@drawable/ic_player_back" />

        <ImageButton
            android:id="@+id/btnKeyHome"
            style="@style/RemoteRoundKey"
            android:contentDescription="Home"
            android:src="@drawable/ic_remote_home" />

        <ImageButton
            android:id="@+id/btnKeyPlayPause"
            style="@style/RemoteRoundKey"
            android:contentDescription="Play or pause"
            android:src="@drawable/ic_remote_playpause" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnKeyFullscreen"
        style="@style/RemotePill"
        android:layout_width="@dimen/remote_cluster_width"
        android:layout_height="@dimen/remote_pill_height"
        android:layout_marginTop="@dimen/remote_row_gap"
        android:text="Full screen" />

    <LinearLayout
        android:layout_width="@dimen/remote_cluster_width"
        android:layout_height="@dimen/remote_rocker_height"
        android:layout_marginTop="@dimen/remote_row_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/remote_rocker_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyChUp"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Channel up"
                android:text="+" />

            <TextView
                style="@style/RemoteRockerLabel"
                android:text="CH" />

            <TextView
                android:id="@+id/btnKeyChDown"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Channel down"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyGuide"
                style="@style/RemotePill"
                android:text="Guide" />

            <TextView
                android:id="@+id/btnKeyLast"
                style="@style/RemotePill"
                android:text="Last" />

            <TextView
                android:id="@+id/btnKeyMute"
                style="@style/RemotePill"
                android:text="Mute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/remote_rocker_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnKeyVolUp"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Volume up"
                android:text="+" />

            <TextView
                style="@style/RemoteRockerLabel"
                android:text="VOL" />

            <TextView
                android:id="@+id/btnKeyVolDown"
                style="@style/RemoteRockerHalf"
                android:contentDescription="Volume down"
                android:text="−" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
