<?xml version="1.0" encoding="utf-8"?>
<!-- One universal search result: picture, title, what and where (channel, time, provider), and a
     label for its kind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    android:background="@drawable/channel_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/ivResultImage"
        android:layout_width="44dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:background="@color/rack_control_off"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/rack_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvResultDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rack_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />
</LinearLayout>
