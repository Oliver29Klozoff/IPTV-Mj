<?xml version="1.0" encoding="utf-8"?>
<!-- One Smart Home row: its title and a sideways list of cards (SmartHomeAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- The row name, and on the TV home's poster rows the focused poster's title (its text is
         not shown under the poster there: SmartHomeAdapter hidePosterText). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHomeRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textColor="@color/rack_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvHomeRowFocus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_condensed_bold"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/rack_text"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHomeRowCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp" />

    <!-- A row kept while empty (HomeLayout showWhenEmpty): what will appear here, instead of cards. -->
    <TextView
        android:id="@+id/tvHomeRowEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:focusable="true"
        android:background="@drawable/rack_row_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
