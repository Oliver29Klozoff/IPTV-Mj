<?xml version="1.0" encoding="utf-8"?>
<!-- One Smart Home row: its title and a sideways list of cards (SmartHomeAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <TextView
        android:id="@+id/tvHomeRowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/rack_text_secondary"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHomeRowCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp" />
</LinearLayout>
