<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:theme="@style/ThemeOverlay.HomeRack"
    android:orientation="horizontal">

    <!-- Left: series info panel -->
    <LinearLayout
        android:id="@+id/seriesInfoPanel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@color/rack_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivSeriesCover"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/rack_control_off" />

        <TextView
            android:id="@+id/tvSeriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/rack_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSeriesGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/rack_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSeriesRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFD700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSeriesPlot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:textColor="@color/rack_text_muted"
            android:textSize="12sp"
            android:maxLines="8"
            android:ellipsize="end"
            android:scrollbars="vertical" />

        <!-- D-pad focus support (focusable + a visible focus outline + explicit nextFocus chain)
             on every button here — previously none were focusable, so a D-pad couldn't move
             around this screen at all, only touch worked (same fix as VodDetailActivity). -->
        <Button
            android:id="@+id/btnFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:background="@drawable/home_chip_bg"
            android:text="☆  Add to Favorites"
            android:textAllCaps="false"
            android:textColor="@color/rack_text"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/btnWatchTrailer" />

        <Button
            android:id="@+id/btnWatchTrailer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/home_chip_bg"
            android:text="▶  Watch Trailer"
            android:textAllCaps="false"
            android:textColor="@color/rack_text"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnFavorite"
            android:nextFocusDown="@id/btnPlayOnTv" />

        <Button
            android:id="@+id/btnPlayOnTv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/home_chip_bg"
            android:text="📺  Play on TV"
            android:textAllCaps="false"
            android:textColor="@color/rack_text"
            android:textSize="13sp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnWatchTrailer"
            android:nextFocusDown="@id/btnBack" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="← Back"
            android:textColor="@color/rack_text"
            android:background="@drawable/home_tab_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btnPlayOnTv" />
    </LinearLayout>

    <!-- Right: season tabs + episodes list -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabSeasons"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/rack_surface"
            app:tabIndicatorColor="@color/oled_cyan_primary"
            app:tabIndicatorHeight="2dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="@color/rack_text_muted"
            app:tabTextAppearance="@style/HomeRack.TabText"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/oled_cyan_primary"
            android:visibility="gone" />

        <!-- "Previously on..." recap — shown only when resuming a series after a 30+ day gap
             (see SeriesDetailActivity.maybeShowRecap). Dismiss is in-memory only, matching the
             spec ("goes away once you start playing" is enough, no persisted dismissal state). -->
        <LinearLayout
            android:id="@+id/cardRecap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rack_surface"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRecapTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/rack_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecapDismiss"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/rack_text_muted"
                    android:textSize="14sp"
                    android:background="@drawable/home_tab_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecapBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/rack_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="No episodes available"
            android:textColor="@color/rack_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

    </LinearLayout>
</LinearLayout>
