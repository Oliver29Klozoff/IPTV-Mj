<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Home: Home's rows in order, each with Move up / Move down / Shown-Hidden / Edit, and
     Add row, Start on, Reset and Done along the top (HomeCustomizeActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customizeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:theme="@style/ThemeOverlay.HomeRack">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.12"
        android:text="CUSTOMIZE HOME"
        android:textColor="@color/rack_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvCustomizeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCustomizeDone"
                style="@style/HomeEditHeaderChip"
                android:layout_marginStart="0dp"
                android:text="DONE" />

            <TextView
                android:id="@+id/btnCustomizeAdd"
                style="@style/HomeEditHeaderChip"
                android:text="+ ADD ROW" />

            <TextView
                android:id="@+id/btnCustomizeStart"
                style="@style/HomeEditHeaderChip" />

            <TextView
                android:id="@+id/btnCustomizeReset"
                style="@style/HomeEditHeaderChip"
                android:text="RESET HOME" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomizeSections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
