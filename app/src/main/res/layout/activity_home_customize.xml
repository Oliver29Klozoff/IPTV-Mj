<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Home: Home's rows in order, each with Move up / Move down / Shown-Hidden / Edit, and
     Add row, Start on, Reset and Done along the top (HomeCustomizeActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customizeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:theme="@style/ThemeOverlay.HomeRack">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.12"
        android:text="CUSTOMIZE HOME"
        android:textColor="@color/rack_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvCustomizeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <!-- Viewing style: one press sets a preset (ViewingPersona); cards are added in code. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.12"
        android:text="@string/persona_heading"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/personaScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clipToPadding="false"
        android:padding="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/personaCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Card Density & Size (CardDensity): three choices, the selected one outlined. On a short
         screen this block is hidden and the CARDS chip below opens the same choice. -->
    <LinearLayout
        android:id="@+id/densityBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.12"
            android:text="@string/card_density_heading"
            android:textColor="@color/rack_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/densityChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnDensityCompact"
                style="@style/DensityChip"
                android:layout_marginStart="0dp"
                android:text="@string/density_compact_title" />

            <TextView
                android:id="@+id/btnDensityStandard"
                style="@style/DensityChip"
                android:text="@string/density_standard_title" />

            <TextView
                android:id="@+id/btnDensityExpanded"
                style="@style/DensityChip"
                android:text="@string/density_expanded_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDensityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:textColor="@color/rack_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCustomizeDone"
                style="@style/HomeEditHeaderChip"
                android:layout_marginStart="0dp"
                android:text="DONE" />

            <TextView
                android:id="@+id/btnCustomizeAdd"
                style="@style/HomeEditHeaderChip"
                android:text="+ ADD ROW" />

            <TextView
                android:id="@+id/btnCustomizeStart"
                style="@style/HomeEditHeaderChip" />

            <!-- Short screens only: Card Density & Size, in place of the three choices above. -->
            <TextView
                android:id="@+id/btnCustomizeDensity"
                style="@style/HomeEditHeaderChip"
                android:visibility="gone" />

            <!-- TV only: Home Mini Player Display (Hero, Compact or Off). -->
            <TextView
                android:id="@+id/btnCustomizeMiniPlayer"
                style="@style/HomeEditHeaderChip"
                android:visibility="gone" />

            <!-- TV only: shows or hides Home in the sidebar. -->
            <TextView
                android:id="@+id/btnCustomizeHomeTab"
                style="@style/HomeEditHeaderChip"
                android:visibility="gone" />

            <!-- TV only: Customize Sidebar (order and Shown/Hidden of the sidebar's entries). -->
            <TextView
                android:id="@+id/btnCustomizeSidebar"
                style="@style/HomeEditHeaderChip"
                android:contentDescription="Customize Sidebar Sections: order and which entries show"
                android:text="SIDEBAR…"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnCustomizeReset"
                style="@style/HomeEditHeaderChip"
                android:text="RESET HOME" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomizeSections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
