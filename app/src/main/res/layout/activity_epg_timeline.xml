<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/timelineTopBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnTimelineBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:text="← Guide"
            android:textColor="#008CFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTimelinePrevDay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@android:color/transparent"
            android:text="◀"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTimelineDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="72dp"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTimelineNextDay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:background="@android:color/transparent"
            android:text="▶"
            android:textColor="#888888"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTimelineSearch"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/search_bg"
            android:hint="Search channels…"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="13sp"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btnTimelineNow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:text="NOW ▶"
            android:textColor="#008CFF"
            android:textSize="13sp" />

        <!-- The Guide previously had no way to force a fresh EPG fetch at all — loadGuide()'s
             own staleness check only looks at the newest cached stop-timestamp ACROSS EVERY
             provider, so one provider's far-future cached data (even if wrong/mismatched) could
             mask another provider's genuinely stale/incorrect rows indefinitely with no way to
             force a redo short of reinstalling or clearing app data. -->
        <ImageButton
            android:id="@+id/btnTimelineRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#888888"
            android:contentDescription="Refresh guide" />

    </LinearLayout>

    <!-- Header row: channel column spacer + time labels -->
    <LinearLayout
        android:id="@+id/timelineHeader"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="#141414"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineTopBar">

        <!-- Spacer matching channel column width -->
        <View
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="#1A1A1A" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2A2A2A" />

        <HorizontalScrollView
            android:id="@+id/timeHeaderScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/timeHeaderContent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Loading indicator — shown only until real fetch progress is known (see
         timelineSyncProgressContainer below, which takes over once the network fetch actually
         starts and can report "N/Total"). -->
    <ProgressBar
        android:id="@+id/timelineProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#008CFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineHeader" />

    <!-- Determinate guide-fetch progress — mirrors the home screen's syncProgressContainer
         (same "Loading X… N/Total" + percent-bar pattern already used for merged channel/movie/
         series refreshes), so loading the Guide isn't just a bare spinner with no sense of how
         much is left. -->
    <LinearLayout
        android:id="@+id/timelineSyncProgressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineHeader">

        <TextView
            android:id="@+id/tvTimelineSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/timelineSyncProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#008CFF" />

    </LinearLayout>

    <!-- Shown only when there's truly no cached guide data at all AND the network fetch just
         failed — normally cached-but-stale data is shown instead (see HomeViewModel.loadGuide
         kdoc), so this is specifically the cold-start-with-no-connectivity-ever case. -->
    <TextView
        android:id="@+id/tvTimelineEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="No guide data available — check your connection and try refreshing."
        android:textColor="#888888"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineHeader" />

    <!-- Channel rows -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTimeline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
