<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player (v6.93 Studio Rack redesign, from the approved "MKTV Player Redesign"
     mockup). Every view id and view type from before is kept — PlayerActivity drives them all —
     only their places and looks changed:
     - osdTopBar: back, channel title + quality / LIVE tags with the show on now / next under it
       (epgOverlay), the record / health / HDR badge, Cast, and the tool chips (Audio·CC, Fit,
       Stats, Sleep, Party, Notes, Lock, Quick Zap) that used to sit in the bottom row.
     - bottomControls: just back-30 / play-pause / LIVE, near the bottom (centred until v6.99).
     - vodSeekContainer: along the bottom.
     - guideContainer: the favorites list as a Quick Zap strip along the bottom (was a side drawer).
     Scrims, the top bar and the chips appear and hide with the rest of the overlay. Semantic colors
     (brightness yellow, live red, HDR badge, health dot, stats green) are unchanged. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:theme="@style/ThemeOverlay.HomeRack">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:use_controller="false"
        app:show_timeout="5000" />

    <!-- Darken the video under the top bar and the bottom area while the controls show -->
    <View
        android:id="@+id/playerTopScrim"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/player_scrim_top"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/playerBottomScrim"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/player_scrim_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Buffering spinner -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="@color/oled_cyan_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Reconnecting status -->
    <TextView
        android:id="@+id/tvRetryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="#FF8800"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBuffering" />

    <!-- Left brightness indicator -->
    <LinearLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="44dp"
        android:layout_height="184dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center|bottom"
        android:padding="6dp"
        android:background="@drawable/player_gesture_indicator_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvBrightnessIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="#FFDD00"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/tvBrightnessPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <ProgressBar
            android:id="@+id/brightnessBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#FFDD00"
            android:progressBackgroundTint="#444444"
            android:rotation="270" />
    </LinearLayout>

    <!-- Right volume indicator -->
    <LinearLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="44dp"
        android:layout_height="184dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center|bottom"
        android:padding="6dp"
        android:background="@drawable/player_gesture_indicator_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvVolumeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/oled_cyan_primary"
            android:progressBackgroundTint="#444444"
            android:rotation="270" />
    </LinearLayout>

    <!-- Top bar: back · what's on · badges · Cast · tool chips -->
    <LinearLayout
        android:id="@+id/osdTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_chip_bg"
            android:src="@drawable/ic_player_back"
            android:contentDescription="Back"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- Title line (channel + quality + LIVE), then the show on now and next -->
        <LinearLayout
            android:id="@+id/epgOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChannelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_semibold"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="4"
                    android:textColor="@color/rack_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvOsdQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_chip_bg"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/rack_text"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvOsdLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:letterSpacing="0.1"
                    android:text="● LIVE"
                    android:textColor="@color/rack_danger_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Now and next share one line so the top bar stays a single row under the title. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEpgNow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="4"
                    android:textColor="@color/rack_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEpgNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="4"
                    android:textColor="@color/rack_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bufferHealthBadge"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <!-- Small record indicator/button — replaces the old full-size camera-icon
                 transport button. Tap opens the same record-duration dialog btnRecord used to;
                 blinks (see startRecordDotBlink() in PlayerActivity) while a recording of this
                 channel is actually in progress, otherwise shows solid+dim as a plain button. -->
            <FrameLayout
                android:id="@+id/btnRecordDot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/player_chip_bg"
                android:contentDescription="Record"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:visibility="gone">

                <View
                    android:id="@+id/viewRecordDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:background="@drawable/record_dot" />

            </FrameLayout>

            <View
                android:id="@+id/viewHealthDotPlayer"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/health_dot" />

            <TextView
                android:id="@+id/tvHealthBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:textColor="@color/rack_text"
                android:textSize="12sp" />

            <!-- Real-stream HDR/Dolby Vision badge — only shown once the video track actually
                 decodes as HDR (Format.colorInfo.isTransferHdr or Dolby Vision mimeType), unlike
                 ChannelQualityTag's SD/HD/FHD/4K tag elsewhere, which is just parsed from the
                 channel's name text and can't tell HDR from SDR at all. -->
            <TextView
                android:id="@+id/tvHdrBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/hdr_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Cast button -->
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/btnCast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <!-- Tool chips share the row evenly with the show info and scroll when they don't fit, so a
             narrow phone can't squeeze the channel and now/next out of view. -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

        <Button
            android:id="@+id/btnTracks"
            style="@style/PlayerChip"
            android:text="Audio · CC" />

        <ImageButton
            android:id="@+id/btnResize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/player_chip_bg"
            android:contentDescription="Screen fit"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_fit" />

        <Button
            android:id="@+id/btnStats"
            style="@style/PlayerChip"
            android:text="Stats" />

        <Button
            android:id="@+id/btnSleep"
            style="@style/PlayerChip"
            android:text="Sleep" />

        <Button
            android:id="@+id/btnWatchParty"
            style="@style/PlayerChip"
            android:text="Party" />

        <!-- Time Capsule Rewatch Notes — VOD/EPISODE only, shown/hidden at runtime by
             updateRewatchNotesButtonVisibility() in PlayerActivity since LIVE content never
             shows it (gone by default here, matching btnDvrRewind's own runtime-toggle pattern). -->
        <Button
            android:id="@+id/btnRewatchNotes"
            style="@style/PlayerChip"
            android:text="Notes"
            android:visibility="gone" />

        <!-- Chapter marks — recordings only (shown at runtime): save spots to jump back to -->
        <Button
            android:id="@+id/btnMarks"
            style="@style/PlayerChip"
            android:text="Marks"
            android:visibility="gone" />

        <!-- Audio only — live channels; hands the stream to AudioOnlyService (see audioOnlyPanel) -->
        <Button
            android:id="@+id/btnAudioOnly"
            style="@style/PlayerChip"
            android:text="Listen"
            android:visibility="gone" />

        <!-- Lock (v6.93): ignores touches so the screen can't be bumped; touch-screens only -->
        <Button
            android:id="@+id/btnLock"
            style="@style/PlayerChip"
            android:text="Lock" />

        <!-- Quick Zap: shows / hides the favorites strip along the bottom -->
        <ImageButton
            android:id="@+id/btnGuide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/player_chip_bg"
            android:contentDescription="Quick zap"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_zap"
            android:visibility="gone" />

        </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Persistent Watch Party badge — deliberately NOT part of the auto-hiding overlay group
         (hideRunnable/showOverlay), same reasoning as PiP's always-visible affordances, since
         "you're in a synced party" is state worth surfacing even with controls hidden. Tap
         re-opens the party status/leave dialog, same handler as btnWatchParty. -->
    <TextView
        android:id="@+id/tvWatchPartyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:background="#AA000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Watch Party"
        android:textColor="#00CC66"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back 30 s · play / pause · LIVE, near the bottom (v6.99): stacked above the seek bar
         and the Quick Zap strip; hidden ones drop out, so live TV puts it just above the edge. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="6dp"
        app:layout_goneMarginBottom="28dp"
        app:layout_constraintBottom_toTopOf="@id/liveProgramBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- VOD skip buttons (movies, episodes, recordings, catch-up), shown at runtime -->
        <Button
            android:id="@+id/btnVodBack"
            style="@style/PlayerSkipButton"
            android:layout_marginEnd="20dp"
            android:contentDescription="Back 10 seconds"
            android:text="−10" />

        <ImageButton
            android:id="@+id/btnDvrRewind"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/player_round_bg"
            android:contentDescription="Back 30 seconds"
            android:src="@drawable/ic_player_rewind"
            android:scaleType="fitCenter"
            android:padding="15dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/player_round_bg"
            android:contentDescription="Play or pause"
            android:src="@android:drawable/ic_media_pause"
            android:scaleType="fitCenter"
            android:padding="16dp"
            app:tint="#FF000000" />


        <Button
            android:id="@+id/btnVodFwd"
            style="@style/PlayerSkipButton"
            android:layout_marginStart="20dp"
            android:contentDescription="Forward 30 seconds"
            android:text="+30" />

        <Button
            android:id="@+id/btnVodFwdBig"
            style="@style/PlayerSkipButton"
            android:layout_marginStart="12dp"
            android:contentDescription="Forward 2 minutes"
            android:text="+2 MIN" />

        <!-- After the skip buttons so a Start Over replay reads −10 · play · +30 · +2 MIN · LIVE;
             live mode only shows back-30 · play · LIVE, unchanged. -->
        <Button
            android:id="@+id/btnDvrLive"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            app:backgroundTint="@null"
            android:background="@drawable/player_round_bg"
            android:fontFamily="@font/barlow_condensed_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.1"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:text="● LIVE"
            android:textColor="@color/rack_danger_text"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Streaming stats overlay -->
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="76dp"
        android:background="#DD000000"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Live show progress (v6.99): start time, how far into the show, end time — for live channels
         with guide data; shown and hidden with the rest of the overlay (PlayerActivity.showOverlay). -->
    <LinearLayout
        android:id="@+id/liveProgramBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_goneMarginBottom="18dp"
        app:layout_constraintBottom_toTopOf="@id/vodSeekContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Start Over: replays the show on now from its beginning (catch-up channels only;
             PlayerActivity.startOverCurrentShow). Shown only when it can work. -->
        <Button
            android:id="@+id/btnStartOver"
            style="@style/PlayerChip"
            android:layout_height="32dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="12dp"
            android:text="⟲ Start over"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLiveProgramStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="@color/rack_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/liveProgramProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:max="1000" />

        <TextView
            android:id="@+id/tvLiveProgramEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="@color/rack_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- VOD seek bar — not inside epgOverlay since it needs its own visibility toggling
         (PlayerActivity.showOverlay/hideRunnable's isVod branches) independent of that view's
         own show/hide calls. Auto-hides with the rest of the transient controls. Along the bottom
         now that the transport row sits in the centre. -->
    <RelativeLayout
        android:id="@+id/vodSeekContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/guideContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/oled_cyan_primary"
            android:thumbTint="@color/rack_text" />

        <TextView
            android:id="@+id/tvTimeElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/seekBar"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:textColor="@color/rack_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/seekBar"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:textColor="@color/rack_text_secondary"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- Channel zones (click to switch) -->
    <View
        android:id="@+id/zonePrevious"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.10"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/zoneNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.10"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="1" />

    <!-- Channel Change OSD: brief top-right banner on D-pad/swipe channel flip -->
    <LinearLayout
        android:id="@+id/channelOsd"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/player_osd_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvOsdChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_semibold"
            android:maxLines="1"
            android:textColor="@color/rack_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvOsdEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/rack_text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/osdEpgProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/rack_control_off"
            android:progressTint="@color/oled_cyan_primary" />
    </LinearLayout>

    <!-- Quick Zap: favorite channels as cards along the bottom (was a left-hand drawer) -->
    <LinearLayout
        android:id="@+id/guideContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/barlow_condensed_bold"
                android:letterSpacing="0.14"
                android:text="QUICK ZAP"
                android:textColor="@color/rack_text"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnCloseGuide"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/player_chip_bg"
                android:contentDescription="Close quick zap"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/rack_text" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavoritesGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp" />

    </LinearLayout>

    <!-- Audio only: covers the (released) video while AudioOnlyService plays the channel's sound -->
    <LinearLayout
        android:id="@+id/audioOnlyPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/rack_bg"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.16"
            android:text="AUDIO ONLY"
            android:textColor="@color/rack_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAudioOnlyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/barlow_semibold"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/rack_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/barlow"
            android:gravity="center"
            android:text="Keeps playing with the screen off or in another app. Controls are in your notifications."
            android:textColor="@color/rack_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnShowPicture"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            app:backgroundTint="@null"
            android:background="@drawable/player_round_bg"
            android:fontFamily="@font/barlow_condensed_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.1"
            android:paddingHorizontal="22dp"
            android:text="SHOW PICTURE"
            android:textColor="@color/rack_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Locked (v6.93): the only touch that gets through while the screen is locked -->
    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="28dp"
        app:backgroundTint="@null"
        android:background="@drawable/player_chip_bg"
        android:fontFamily="@font/barlow_condensed_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.1"
        android:paddingHorizontal="18dp"
        android:text="Locked · tap to unlock"
        android:textColor="@color/rack_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Up Next card — shown at episode end -->
    <LinearLayout
        android:id="@+id/upNextCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/player_osd_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvUpNextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:text="Up Next"
            android:textColor="@color/rack_text_muted"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/tvUpNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/barlow_semibold"
            android:textColor="@color/rack_text"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/upNextProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/oled_cyan_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUpNextPlay"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                app:backgroundTint="@null"
                android:background="@drawable/player_chip_bg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.1"
                android:text="Play now"
                android:textColor="@color/rack_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnUpNextCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:backgroundTint="@null"
                android:background="@drawable/player_chip_bg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.1"
                android:text="Cancel"
                android:textColor="@color/rack_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Shown during the last minute of a series episode (well before STATE_ENDED/credits),
         letting you skip straight to the next episode instead of waiting through the credits
         for the Up Next card above to appear. Hidden whenever Up Next is showing/already acted
         on, since at that point this would be redundant. -->
    <Button
        android:id="@+id/btnSkipToNextEpisode"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="24dp"
        app:backgroundTint="@null"
        android:background="@drawable/player_chip_bg"
        android:fontFamily="@font/barlow_condensed_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.1"
        android:paddingHorizontal="16dp"
        android:text="Skip to next episode  ▶"
        android:textColor="@color/rack_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
