<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:use_controller="false"
        app:show_timeout="5000" />

    <!-- Buffering spinner -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="#008CFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Reconnecting status -->
    <TextView
        android:id="@+id/tvRetryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="#FF8800"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBuffering" />

    <!-- Left brightness indicator -->
    <LinearLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="44dp"
        android:layout_height="184dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center|bottom"
        android:padding="6dp"
        android:background="@drawable/player_gesture_indicator_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvBrightnessIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="#FFDD00"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/tvBrightnessPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <ProgressBar
            android:id="@+id/brightnessBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#FFDD00"
            android:progressBackgroundTint="#444444"
            android:rotation="270" />
    </LinearLayout>

    <!-- Right volume indicator -->
    <LinearLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="44dp"
        android:layout_height="184dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center|bottom"
        android:padding="6dp"
        android:background="@drawable/player_gesture_indicator_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvVolumeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#008CFF"
            android:progressBackgroundTint="#444444"
            android:rotation="270" />
    </LinearLayout>

    <!-- Top left: Guide -->
    <ImageButton
        android:id="@+id/btnGuide"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/tv_sidebar_focus"
        android:src="@android:drawable/ic_menu_agenda"
        android:nextFocusDown="@id/btnPlayPause"
        android:padding="8dp"
        app:tint="#008CFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Persistent Watch Party badge — deliberately NOT part of the auto-hiding overlay group
         (hideRunnable/showOverlay), same reasoning as PiP's always-visible affordances, since
         "you're in a synced party" is state worth surfacing even with controls hidden. Tap
         re-opens the party status/leave dialog, same handler as btnWatchParty. -->
    <TextView
        android:id="@+id/tvWatchPartyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:background="#AA000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Watch Party"
        android:textColor="#00CC66"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top right: Close -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        android:background="@drawable/tv_sidebar_focus"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:nextFocusDown="@id/btnStats"
        android:padding="8dp"
        app:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bufferHealthBadge"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btnCast"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Small record indicator/button — replaces the old full-size camera-icon
             transport button. Tap opens the same record-duration dialog btnRecord used to;
             blinks (see startRecordDotBlink() in PlayerActivity) while a recording of this
             channel is actually in progress, otherwise shows solid+dim as a plain button. -->
        <FrameLayout
            android:id="@+id/btnRecordDot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tv_sidebar_focus"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:visibility="gone">

            <View
                android:id="@+id/viewRecordDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:background="@drawable/record_dot" />

        </FrameLayout>

        <View
            android:id="@+id/viewHealthDotPlayer"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/health_dot" />

        <TextView
            android:id="@+id/tvHealthBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Real-stream HDR/Dolby Vision badge — only shown once the video track actually
             decodes as HDR (Format.colorInfo.isTransferHdr or Dolby Vision mimeType), unlike
             ChannelQualityTag's SD/HD/FHD/4K tag elsewhere, which is just parsed from the
             channel's name text and can't tell HDR from SDR at all. -->
        <TextView
            android:id="@+id/tvHdrBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/hdr_badge_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Cast button -->
    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/btnCast"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Bottom controls: Sleep | Play/Pause | CC — anchored to the very bottom; everything else
         in this transient-overlay stack (vodSeekContainer, epgOverlay) is built to sit ABOVE this
         row (layout_constraintBottom_toTopOf, see their own comments) instead of every element
         independently pinning to parent's bottom, which used to leave the seek bar, the channel
         title, and this button row all rendering in the same overlapping screen space. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSleep"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="⏱"
            android:textColor="#AAAAAA"
            android:textSize="28sp"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnGuide"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <ImageButton
            android:id="@+id/btnDvrRewind"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_sidebar_focus"
            android:src="@android:drawable/ic_media_rew"
            android:nextFocusUp="@id/btnGuide"
            android:scaleType="fitCenter"
            android:padding="14dp"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_sidebar_focus"
            android:src="@android:drawable/ic_media_pause"
            android:nextFocusUp="@id/btnGuide"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="#FFFFFF" />

        <Button
            android:id="@+id/btnDvrLive"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:minWidth="72dp"
            android:text="● LIVE"
            android:textColor="#FF3B30"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnGuide"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTracks"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="CC"
            android:textColor="#008CFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnBack"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btnWatchParty"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="👥"
            android:textColor="#AAAAAA"
            android:textSize="22sp"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnBack"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <!-- Time Capsule Rewatch Notes — VOD/EPISODE only, shown/hidden at runtime by
             updateRewatchNotesButtonVisibility() in PlayerActivity since LIVE content never
             shows it (gone by default here, matching btnDvrRewind's own runtime-toggle pattern). -->
        <Button
            android:id="@+id/btnRewatchNotes"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="📝"
            android:textColor="#AAAAAA"
            android:textSize="22sp"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnBack"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStats"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="📊"
            android:textColor="#AAAAAA"
            android:textSize="24sp"
            android:background="@drawable/tv_sidebar_focus"
            android:nextFocusUp="@id/btnBack"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <ImageButton
            android:id="@+id/btnResize"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/tv_sidebar_focus"
            android:src="@android:drawable/ic_menu_crop"
            android:nextFocusUp="@id/btnBack"
            android:scaleType="fitCenter"
            android:padding="16dp"
            app:tint="#008CFF" />
    </LinearLayout>

    <!-- Compact buffer health badge (always visible during playback) -->


    <!-- Streaming stats overlay -->
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#DD000000"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- VOD seek bar — not inside epgOverlay since it needs its own visibility toggling
         (PlayerActivity.showOverlay/hideRunnable's isVod branches) independent of that view's
         own show/hide calls. Auto-hides with the rest of the transient controls, same timing as
         everything else. Sits directly above bottomControls (not independently pinned to
         parent's bottom like every element here used to be) so the two don't render on top of
         each other. -->
    <RelativeLayout
        android:id="@+id/vodSeekContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#008CFF"
            android:thumbTint="#008CFF" />

        <TextView
            android:id="@+id/tvTimeElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/seekBar"
            android:layout_alignParentStart="true"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/seekBar"
            android:layout_alignParentEnd="true"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Bottom EPG/info overlay — for VOD this shows only the movie title (tvEpgNow/tvEpgNext
         stay empty, see PlayerActivity.showOverlay's !isVod guard), sitting directly above
         vodSeekContainer instead of overlapping it at the same bottom position like before. For
         live TV, vodSeekContainer is never shown (GONE, zero height), so this still lands
         correctly right above bottomControls in that case. -->
    <RelativeLayout
        android:id="@+id/epgOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/vodSeekContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvChannelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEpgNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_above="@id/tvChannelTitle"
            android:layout_marginBottom="2dp"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEpgNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_above="@id/tvEpgNow"
            android:layout_marginBottom="2dp"
            android:textColor="#888888"
            android:textSize="12sp" />

    </RelativeLayout>

    <!-- Channel zones (click to switch) -->
    <View
        android:id="@+id/zonePrevious"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.10"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/zoneNext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.10"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="1" />

    <!-- Channel Change OSD: brief top-right banner on D-pad/swipe channel flip -->
    <LinearLayout
        android:id="@+id/channelOsd"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="#DD000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvOsdChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOsdEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/osdEpgProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#444444"
            android:progressTint="#008CFF" />
    </LinearLayout>

    <!-- Favorites guide drawer -->
    <LinearLayout
        android:id="@+id/guideContainer"
        android:layout_width="340dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favorites"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseGuide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavoritesGuide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp" />

    </LinearLayout>

    <!-- Up Next card — shown at episode end -->
    <LinearLayout
        android:id="@+id/upNextCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="24dp"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvUpNextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up Next"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvUpNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/upNextProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#E50914" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUpNextPlay"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Play Now"
                android:textSize="12sp"
                android:backgroundTint="#E50914" />

            <Button
                android:id="@+id/btnUpNextCancel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Cancel"
                android:textSize="12sp"
                android:backgroundTint="#444444" />

        </LinearLayout>

    </LinearLayout>

    <!-- Shown during the last minute of a series episode (well before STATE_ENDED/credits),
         letting you skip straight to the next episode instead of waiting through the credits
         for the Up Next card above to appear. Hidden whenever Up Next is showing/already acted
         on, since at that point this would be redundant. -->
    <Button
        android:id="@+id/btnSkipToNextEpisode"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#CC000000"
        android:text="Skip to Next Episode  ▶"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
