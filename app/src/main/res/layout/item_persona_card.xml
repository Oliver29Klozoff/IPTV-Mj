<?xml version="1.0" encoding="utf-8"?>
<!-- One viewing style card in Customize Home (HomeCustomizeActivity.buildPersonaCards). The whole
     card is one focusable button; its parts are read out as one description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/persona_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="96dp"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPersonaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPersonaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_condensed_bold"
            android:importantForAccessibility="no"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/rack_text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPersonaDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="3"
        android:textColor="@color/rack_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvPersonaActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:importantForAccessibility="no"
        android:letterSpacing="0.08"
        android:text="@string/persona_active"
        android:textColor="@color/rack_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
