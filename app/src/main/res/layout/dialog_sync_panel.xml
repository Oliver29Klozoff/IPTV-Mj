<?xml version="1.0" encoding="utf-8"?>
<!-- Audio & Subtitle Sync (player): two offsets, each with its value shown large while the video
     keeps playing below (it sits at the top, clear of the subtitles). Remote: Up/Down picks a row, Left/Right on a value row moves it by 50 ms
     (faster when held), the step buttons give 50/100/500 ms, Back closes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#E6000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/epg_inset"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/epg_inset"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Rack.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio &amp; subtitle sync" />

        <TextView
            android:id="@+id/tvItem"
            style="@style/Rack.Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" />

        <!-- The two controls: one above the other on a phone, side by side on a wide screen (SyncPanel). -->
        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/colAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Audio -->
        <LinearLayout
            android:id="@+id/rowAudio"
            style="@style/Rack.Row.Tappable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rack.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Audio delay" />

                <TextView
                    android:id="@+id/tvAudioValue"
                    style="@style/Rack.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAudioMeaning"
                style="@style/Rack.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvAudioStatus"
                style="@style/Rack.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rack_text_secondary" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/audioSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/colSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Subtitles -->
        <LinearLayout
            android:id="@+id/rowSubtitle"
            style="@style/Rack.Row.Tappable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Rack.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtitle delay" />

                <TextView
                    android:id="@+id/tvSubtitleValue"
                    style="@style/Rack.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubtitleMeaning"
                style="@style/Rack.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvSubtitleStatus"
                style="@style/Rack.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rack_text_secondary" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/subtitleSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Rack.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save for this item" />

                <Button
                    android:id="@+id/btnUseSaved"
                    style="@style/Rack.Button.Neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Use saved" />

                <Button
                    android:id="@+id/btnResetBoth"
                    style="@style/Rack.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Reset both" />

                <Button
                    android:id="@+id/btnMove"
                    style="@style/Rack.Button.Neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Move down" />

                <Button
                    android:id="@+id/btnClose"
                    style="@style/Rack.Button.Neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Close" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
