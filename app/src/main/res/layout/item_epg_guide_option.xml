<?xml version="1.0" encoding="utf-8"?>
<!-- A guide channel the user can choose: its name, guide, why it is suggested, and its next
     listings, so East and West feeds can be told apart. Selecting it asks before saving. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Rack.Row.Tappable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvName"
        style="@style/Rack.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvSource"
        style="@style/Rack.Eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2" />

    <TextView
        android:id="@+id/tvReason"
        style="@style/Rack.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvListings"
        style="@style/Rack.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/rack_text_secondary" />
</LinearLayout>
