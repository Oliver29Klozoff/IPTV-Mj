<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Peek row: number, logo, name (with PLAYING and the favorite star), the show on now with
     the time left and a thin progress bar, and what's next. Background set by QuickPeekAdapter:
     the remote's focus ring for the highlighted row, an accent outline for the playing one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvPeekNum"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivPeekLogo"
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:background="@color/rack_control_off"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPeekName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_semibold"
                android:maxLines="1"
                android:textColor="@color/rack_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPeekFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="★"
                android:textColor="@color/oled_favorite_gold"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPeekPlaying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/barlow_condensed_bold"
                android:letterSpacing="0.1"
                android:text="● PLAYING"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPeekNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rack_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPeekLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:maxLines="1"
                android:textColor="@color/rack_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/peekProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:max="1000" />

        <TextView
            android:id="@+id/tvPeekNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rack_text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
