<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/ThemeOverlay.HomeRack"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg">

    <!-- STEP: Recordings List -->
    <LinearLayout
        android:id="@+id/stepList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCHEDULED RECORDINGS"
                android:textColor="@color/oled_cyan_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnRecordingStorageSettings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="STORAGE"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="20dp"
                android:layout_marginEnd="12dp" />

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnToggleScheduleView"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SCHEDULE VIEW"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="20dp"
                android:layout_marginEnd="12dp" />

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnAddNew"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="+ SCHEDULE NEW"
                android:textColor="@color/oled_cyan_primary"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="20dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rack_border"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No recordings scheduled. Press  + SCHEDULE NEW  to add one."
            android:textColor="@color/rack_text_muted"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingTop="40dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecordings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:descendantFocusability="afterDescendants" />

        <LinearLayout
            android:id="@+id/dayPagingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnDayPrev"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="◀ PREV DAY"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/tvDayLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/rack_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnDayNext"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="NEXT DAY ▶"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scheduleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <com.iptvapp.ui.recordings.DayScheduleView
                android:id="@+id/dayScheduleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp" />
        </ScrollView>

    </LinearLayout>

    <!-- STEP: Category Picker -->
    <LinearLayout
        android:id="@+id/stepCategory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnCatBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="← BACK"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SELECT CATEGORY"
                android:textColor="@color/rack_text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/etSearchCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/home_search_bg"
            android:hint="Search categories…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/rack_text"
            android:textColorHint="@color/rack_text_muted"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rack_border"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

    <!-- STEP: Channel Picker -->
    <LinearLayout
        android:id="@+id/stepChannel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <Button
                app:backgroundTint="@null"
                android:id="@+id/btnChanBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="← CATEGORIES"
                android:textColor="@color/rack_text_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/home_tab_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tvChanCategoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/rack_text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/etSearchChannel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/home_search_bg"
            android:hint="Search channels…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/rack_text"
            android:textColorHint="@color/rack_text_muted"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rack_border"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

</FrameLayout>
