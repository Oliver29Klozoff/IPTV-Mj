<?xml version="1.0" encoding="utf-8"?>
<!-- Phone remote channel picker: favorites, or search results as you type. Tapping one tunes the TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <EditText
        android:id="@+id/etRemoteSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/home_search_bg"
        android:fontFamily="@font/barlow"
        android:hint="Search channels to put on the TV"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/rack_text"
        android:textColorHint="@color/rack_text_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvRemoteListLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.12"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="FAVORITES"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRemoteChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
