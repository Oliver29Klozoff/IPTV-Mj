<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by SettingsActivity.updateServerList for the provider cards' buttons, so the
     Kotlin-built cards share the exact same button styles as the rest of activity_settings.xml
     instead of re-creating them by hand in code. -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SettingsUi.Button.Primary"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    app:cornerRadius="8dp" />
