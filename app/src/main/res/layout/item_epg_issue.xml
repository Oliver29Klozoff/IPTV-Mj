<?xml version="1.0" encoding="utf-8"?>
<!-- One channel in EPG Health's list. The whole row is the D-pad / touch target; opening it
     never changes anything (corrections are applied from the channel's own screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Rack.Row.Tappable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/epg_inset"
    android:layout_marginEnd="@dimen/epg_inset"
    android:minHeight="@dimen/rack_row_min_height"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Rack.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tvDetail"
        style="@style/Rack.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvSuggestion"
        style="@style/Rack.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/rack_text_secondary"
        android:visibility="gone" />
</LinearLayout>
