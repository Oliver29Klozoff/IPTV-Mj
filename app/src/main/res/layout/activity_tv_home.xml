<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090F"
    android:orientation="horizontal">

    <!-- LEFT PANEL: drillable (sidebar → categories → channels). Width is set at runtime —
         narrow (fit to the sidebar's own text) while showing the sidebar, wider once
         drilled into a category/channel/guide list so that list gets more room. -->
    <FrameLayout
        android:id="@+id/tvLeftPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent">

        <!-- LEVEL 0: Sidebar nav. With Favorites/Live/Categories/Movies/Series/Guide/Providers/
             Recordings/Settings all present, the fixed-height button stack no longer fits on
             shorter TV panel heights and was running off the bottom of the screen — the button
             list below is now wrapped in its own ScrollView (weight=1) so it scrolls instead of
             overflowing, while Settings stays pinned at a fixed spot at the very bottom. -->
        <LinearLayout
            android:id="@+id/tvSidebar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0C0F1A"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="fitCenter"
                    android:contentDescription="MKTV" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:id="@+id/tvMktvWordmark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MKTV"
                        android:textColor="#008CFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvClock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1E2A3A" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <Button
                android:id="@+id/btnTvFavorites"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="FAVORITES"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="35dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvProviders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="PROVIDERS"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="35dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvLive"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="LIVE"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="50dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvCategories"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="start|center_vertical"
                android:paddingStart="30dp"
                android:text="CATEGORIES"
                android:textAllCaps="false"
                android:textColor="#008CFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTvMovies"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="MOVIES"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="45dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvSeries"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SERIES"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="45dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvGuide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="GUIDE"
                android:textColor="#008CFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="48dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btnTvRecordings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="RECORDINGS"
                android:textColor="#888888"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="28dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <!-- Hidden grid toggle kept for binding compatibility -->
            <Button
                android:id="@+id/btnTvGrid"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:visibility="gone" />

            </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <Button
                android:id="@+id/btnTvSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⚙  SETTINGS"
                android:textColor="#888888"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:background="@drawable/tv_sidebar_focus"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </LinearLayout>

        <!-- LEVEL 1: Category panel (hidden until drill-in) -->
        <LinearLayout
            android:id="@+id/tvCatPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0C0F1A"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0A0D16">

                <Button
                    android:id="@+id/tvBtnCatBack"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:text="←"
                    android:textSize="18sp"
                    android:textColor="#888888"
                    android:background="@drawable/tv_sidebar_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusDown="@id/tvBtnProvidersModeChannels" />

                <TextView
                    android:id="@+id/tvCatTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2A3A" />

            <!-- PROVIDERS MODE ROW — Channels/Movies/Series direct-select buttons side by side,
                 visible only while the PROVIDERS sidebar section is active and at its top
                 (server-picker) level — see TvHomeActivity.showMergedChannelsPanel/
                 showMergedVodPanel/showMergedSeriesPanel. Phone equivalent is providersModeRow
                 in activity_home.xml. tvCatPanel (not tvChanPanel) is what's actually visible at
                 this level — see showCategoryPanel(). -->
            <LinearLayout
                android:id="@+id/tvProvidersModeRow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#0C0F1A"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/tvBtnProvidersModeChannels"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Channels"
                    android:textAllCaps="false"
                    android:textColor="#008CFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnCatBack"
                    android:nextFocusDown="@id/tvRvCategories"
                    android:nextFocusRight="@id/tvBtnProvidersModeMovies" />

                <Button
                    android:id="@+id/tvBtnProvidersModeMovies"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Movies"
                    android:textAllCaps="false"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnCatBack"
                    android:nextFocusDown="@id/tvRvCategories"
                    android:nextFocusLeft="@id/tvBtnProvidersModeChannels"
                    android:nextFocusRight="@id/tvBtnProvidersModeSeries" />

                <Button
                    android:id="@+id/tvBtnProvidersModeSeries"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Series"
                    android:textAllCaps="false"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnCatBack"
                    android:nextFocusDown="@id/tvRvCategories"
                    android:nextFocusLeft="@id/tvBtnProvidersModeMovies"
                    android:nextFocusRight="@id/tvBtnProvidersModeRefresh" />

                <!-- Refresh for whichever of Channels/Movies/Series is currently active — shown
                     right in this row so it's reachable at the server-picker level, not just
                     after drilling into a category (tvBtnChanRefresh, the leaf-list refresh
                     button, is a separate/deeper level and easy to never reach). -->
                <Button
                    android:id="@+id/tvBtnProvidersModeRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="⟳"
                    android:textColor="#4FC3F7"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnCatBack"
                    android:nextFocusDown="@id/tvRvCategories"
                    android:nextFocusLeft="@id/tvBtnProvidersModeSeries" />

            </LinearLayout>

            <!-- Refresh progress — tapping the refresh button above previously gave no visible
                 feedback at all while the download was actually in progress (phone's equivalent,
                 syncProgressContainer, is a phone-only view TvHomeActivity never even observed),
                 which reads as "nothing is happening" even when it's genuinely working, and
                 makes an actually-slow/stuck provider indistinguishable from a silent failure. -->
            <LinearLayout
                android:id="@+id/tvProvidersSyncProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0C0F1A"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvProvidersSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/tvProvidersSyncProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressTint="#4FC3F7" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvRvCategories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:focusableInTouchMode="false" />

        </LinearLayout>

        <!-- LEVEL 2: Channel panel (hidden until drill-in) -->
        <LinearLayout
            android:id="@+id/tvChanPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0C0F1A"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0A0D16">

                <Button
                    android:id="@+id/tvBtnChanBack"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:text="←"
                    android:textSize="18sp"
                    android:textColor="#888888"
                    android:background="@drawable/tv_sidebar_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

                <TextView
                    android:id="@+id/tvChanTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tvBtnChanSort"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="⇅ Default"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:visibility="gone"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

                <Button
                    android:id="@+id/tvBtnChanRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="⟳ Refresh"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:visibility="gone"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2A3A" />

            <!-- BULK-SELECT BAR — shown while any of TvHomeActivity's bulkSelectXxxMode flags is
                 active (see updateTvBulkSelectUi). One shared bar for every bulk-selectable list
                 inside tvChanPanel (primary channels, merged channels/movies/series, primary
                 series, Live/Favorites), same "one bar, not one per list" approach as phone's
                 bulkSelectBar in activity_home.xml. -->
            <LinearLayout
                android:id="@+id/tvBulkSelectBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#0C0F1A"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBulkSelectCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/tvBtnBulkSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Select All"
                    android:textAllCaps="false"
                    android:textColor="#008CFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnChanBack"
                    android:nextFocusDown="@id/tvRvContent"
                    android:nextFocusRight="@id/tvBtnBulkSelectDone" />

                <Button
                    android:id="@+id/tvBtnBulkSelectDone"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="#34C759"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnChanBack"
                    android:nextFocusDown="@id/tvRvContent"
                    android:nextFocusLeft="@id/tvBtnBulkSelectAll"
                    android:nextFocusRight="@id/tvBtnBulkSelectHide" />

                <!-- Only shown for channel bulk-select modes (Live/Providers) — VOD/Series bulk-
                     select still use Done alone (Done already means Hide for those, no Favorite
                     concept there), see updateTvBulkSelectUi's TvBulkState.hideAction. -->
                <Button
                    android:id="@+id/tvBtnBulkSelectHide"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="Hide"
                    android:textAllCaps="false"
                    android:textColor="#FFA500"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    android:nextFocusUp="@id/tvBtnChanBack"
                    android:nextFocusDown="@id/tvRvContent"
                    android:nextFocusLeft="@id/tvBtnBulkSelectDone"
                    android:nextFocusRight="@id/tvBtnBulkSelectCancel" />

                <Button
                    android:id="@+id/tvBtnBulkSelectCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/tv_sidebar_focus"
                    android:text="✕"
                    android:textColor="#FF6B6B"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/tvBtnChanBack"
                    android:nextFocusDown="@id/tvRvContent"
                    android:nextFocusLeft="@id/tvBtnBulkSelectDone" />

            </LinearLayout>

            <!-- Search bar inside channel panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#0C0F1A"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/tvEtSearch"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_bg"
                    android:hint="Search…"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tvBtnClearSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="✕"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tvGenreChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="none"
                android:paddingVertical="6dp"
                android:background="#0A0D16">
                <LinearLayout
                    android:id="@+id/tvGenreChipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvRvContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingTop="4dp" />

        </LinearLayout>

        <!-- LEVEL 1b: Guide panel (hidden until GUIDE tab selected) — the live EPG guide
             list used to live permanently under the mini player; it's its own sidebar
             section now instead, freeing that space for the mini player. -->
        <LinearLayout
            android:id="@+id/tvGuidePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0C0F1A"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0A0D16">

                <Button
                    android:id="@+id/tvBtnGuideBack"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:text="←"
                    android:textSize="18sp"
                    android:textColor="#888888"
                    android:background="@drawable/tv_sidebar_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="10dp"
                    android:text="GUIDE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGuideRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:text="⟳ REFRESH"
                    android:textAllCaps="false"
                    android:textColor="#008CFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:background="@drawable/tv_sidebar_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2A3A" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvRvEpgGuide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:paddingTop="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- RIGHT PANEL: mini player only — the EPG guide used to share this space; it's a
         dedicated sidebar section now, so the mini player fills the whole right side. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- MINI PLAYER ROW — fills the whole right panel now that the EPG guide has its
             own sidebar section instead of sharing this space. Channel name + now/next used
             to sit in a side panel next to the video; now it's a full-width footer below it
             instead, since the video no longer needs to share width with anything. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/tvMiniPlayerContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#000000"
                android:focusable="true"
                android:focusableInTouchMode="false">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/tvMiniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <ProgressBar
                    android:id="@+id/tvMiniPlayerProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="#008CFF"
                    android:visibility="gone" />

                <!-- Classic TV channel-number-entry OSD: type digits on the remote from
                     anywhere and it jumps straight to that channel number. -->
                <TextView
                    android:id="@+id/tvChannelNumberEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="#CC000000"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0C0F1A"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTvChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="No channel selected"
                    android:textColor="#008CFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTvEpg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- EPG progress bar: full width, directly under mini player -->
        <ProgressBar
            android:id="@+id/tvEpgProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#1A1F2E"
            android:progressTint="#008CFF"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Loading overlay -->
    <ProgressBar
        android:id="@+id/tvProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#008CFF"
        android:visibility="gone" />

</LinearLayout>
