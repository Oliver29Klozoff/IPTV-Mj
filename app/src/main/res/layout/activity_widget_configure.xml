<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Choose what this widget shows"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgConfigMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <RadioButton
            android:id="@+id/rbConfigModeLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:checked="true"
            android:text="Live Channels"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rbConfigModeContinueWatching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue Watching"
            android:textColor="#FFFFFF" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvConfigHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:text="Pick up to 10 favorites to show. Leave nothing selected to always show your 10 most recent favorites."
        android:textColor="#888888"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lvConfigChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#222222"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvConfigEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="No favorite channels yet — add some in the app first."
        android:textColor="#888888"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnConfigSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="#008CFF"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
