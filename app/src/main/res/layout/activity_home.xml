<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- TOP BAR -->

    <!-- MINI PLAYER -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnSort"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#FFFFFF" />

        <!-- Opens a dialog that searches every configured provider (primary + all extraServers)
             at once across channels/movies/series, tagging each result with its provider —
             distinct from the per-tab etSearch below, which only searches whatever single
             provider/content-type tab is currently open. -->
        <ImageButton
            android:id="@+id/btnSearchAllProviders"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search all providers"
            android:tint="#888888" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="15dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#888888" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Reserves exactly the front-camera cutout's width on devices with a top-center
             punch-hole, so the search box (and Providers toggle right before it) shift clear
             of it instead of drawing underneath — width set at runtime, see HomeActivity's
             topBar inset listener. Zero-width (invisible) on devices with no cutout there. -->
        <View
            android:id="@+id/cutoutSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp" />

        <!-- Was a bare unlabeled icon using the exact same drawable as btnMenu (the main
             hamburger button) — easy to miss or mistake for a second menu button. Distinct
             icon + a text label makes it obvious this is Movies/Series sort (Rating/Year/
             Recently Added), not another entry into the main menu. Also moved to AFTER
             cutoutSpacer — it previously sat before the spacer, so on devices with a top-center
             punch-hole camera it could be drawn partially/fully behind the cutout itself
             instead of being shifted clear of it. -->
        <Button
            android:id="@+id/btnVodSort"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@android:drawable/ic_menu_sort_alphabetically"
            android:drawableTint="#888888"
            android:drawablePadding="4dp"
            android:paddingHorizontal="8dp"
            android:text="Sort"
            android:textAllCaps="false"
            android:textColor="#888888"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="34dp">
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/search_bg"
                android:hint="Search..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="32dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#888888"
                android:contentDescription="Clear search"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/miniPlayerContainer"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.media3.ui.PlayerView
            android:id="@+id/miniPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" >

        </androidx.media3.ui.PlayerView>

        <!-- Cinematic gradient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient_scrim" />

        <!-- Hero info panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivHeroChannelLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniChannelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniEpg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#008CFF"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/miniEpgProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="#008CFF"
                android:visibility="gone" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/miniPlayerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#008CFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCollapsePip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:text="PiP ▼"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- PiP corner overlay - floats over channel list when mini player is collapsed -->
    <FrameLayout
        android:id="@+id/pipCorner"
        android:layout_width="220dp"
        android:layout_height="130dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:background="#000000"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/pipCornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#88000000"
            android:padding="4dp"
            android:id="@+id/tvPipChannelName"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Restore mini player button -->
        <TextView
            android:id="@+id/btnPipRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="#AA000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="↩"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- TABS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#1A1A1A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miniPlayerContainer"
        app:tabIndicatorColor="#008CFF"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#888888">

        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAVORITES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROVIDERS" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOVIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GUIDE" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORY" />
    </com.google.android.material.tabs.TabLayout>

    <!-- PROVIDERS MODE ROW — Live/Movies/Series direct-select buttons side by side, visible
         only when the Providers tab is selected (see HomeActivity's setupTabs). Replaces the
         old single cycling btnProvidersMode toggle that lived in topBar. -->
    <LinearLayout
        android:id="@+id/providersModeRow"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <TextView
            android:id="@+id/btnProvidersModeLive"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:text="Live"
            android:textAllCaps="true"
            android:textColor="#008CFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnProvidersModeMovies"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:text="Movies"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnProvidersModeSeries"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:text="Series"
            android:textAllCaps="true"
            android:textColor="#888888"
            android:textSize="11sp" />

        <!-- Merged/Providers Movies had no sort option at all before — same Rating/Year/
             Recently Added options as primary Movies' btnVodSort, shown only in Movies mode. -->
        <ImageButton
            android:id="@+id/btnProvidersVodSort"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            android:tint="#888888"
            android:contentDescription="Sort movies"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnRefreshProviders"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_notify_sync"
            android:tint="#4FC3F7"
            android:contentDescription="Refresh providers" />

        <!-- Shown only while a bulk-select is active for whichever of Live/Movies/Series is
             currently showing in Providers — hidden the rest of the time so it doesn't crowd
             this already-tight row. -->
        <TextView
            android:id="@+id/btnProvidersSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Select All"
            android:textColor="#008CFF"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- GUIDE MODE ROW — What's On / Grid buttons, moved out of topBar and down here to match
         providersModeRow's placement, visible only when the Guide tab is selected. Stacked
         directly below providersModeRow (both collapse to zero height when gone, so only one
         is ever actually visible at a time — only one tab can be selected). -->
    <LinearLayout
        android:id="@+id/guideModeRow"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/providersModeRow">

        <TextView
            android:id="@+id/btnWhatsOnRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/focus_selector"
            android:text="📋 What's On"
            android:textColor="#008CFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnTimelineViewRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/focus_selector"
            android:text="⏱ Grid"
            android:textColor="#008CFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- BULK-SELECT BAR — one shared bar (not one per tab) for every bulk-selectable list
         (Favorites/primary channels, Providers Live/Movies/Series, the combined Live tab).
         Shown only while that tab's bulk-select mode is active (see HomeActivity's
         updateBulkSelectBar/clearBulkSelection* functions), stacked in the same
         "only one row visible" pattern as guideModeRow/providersModeRow above it. -->
    <LinearLayout
        android:id="@+id/bulkSelectBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideModeRow">

        <TextView
            android:id="@+id/tvBulkSelectCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnBulkSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Select All"
            android:textColor="#008CFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBulkSelectDone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Done"
            android:textColor="#34C759"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBulkSelectCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_selector"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="✕"
            android:textColor="#FF6B6B"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- SYNC PROGRESS — shown while a large catalog (movies/series) is downloading -->
    <LinearLayout
        android:id="@+id/syncProgressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bulkSelectBar">

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <ProgressBar
            android:id="@+id/syncProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="#008CFF" />

    </LinearLayout>

    <!-- CHANNEL LIST AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/syncProgressContainer">

        <!-- Genre filter chips — shown only in Live tab when M3U genres are present -->
        <HorizontalScrollView
            android:id="@+id/genreFilterScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1A1A1A"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/genreChipContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:background="#141414"
                android:paddingTop="8dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#2A2A2A" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingTop="8dp" />

        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#008CFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>