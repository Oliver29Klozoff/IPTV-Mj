<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix-style poster tile for TvHomeActivity's full-screen Movies grid (see
     TvMoviesPosterAdapter / showMoviesFullScreen). match_parent width fills whatever cell width
     the GridLayoutManager assigns it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/tv_sidebar_focus"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#1A1A1A">

        <ImageView
            android:id="@+id/ivVodPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Non-interactive status badge now (favoriting moved to VodDetailActivity's "Add to
             Favorites" button, reached via long-press) — only shown when the movie IS a
             favorite, see TvVodPosterAdapter.bind. Previously a clickable star sitting directly
             on the poster; long-press already opens the detail screen, so a second small
             tap-target for the same underlying action was redundant and harder to hit with a
             D-pad than a dedicated button on the detail screen. -->
        <ImageView
            android:id="@+id/ivVodFavorite"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:src="@android:drawable/btn_star_big_on"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressVod"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#33000000"
            android:progressTint="#008CFF"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvVodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVodRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>
