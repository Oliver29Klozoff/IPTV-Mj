<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Sidebar: the TV sidebar's entries in order, each with Move up / Move down /
     Shown-Hidden, and Done and Reset along the top (TvSidebarCustomizeActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebarCustomizeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:theme="@style/ThemeOverlay.HomeRack">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.12"
        android:text="CUSTOMIZE SIDEBAR"
        android:textColor="@color/rack_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvSidebarCustomizeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="The TV sidebar, top to bottom. Settings always stays at the bottom. Changes are saved as you make them."
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSidebarDone"
            style="@style/SidebarEditHeaderChip"
            android:layout_marginStart="0dp"
            android:contentDescription="Done. Changes are already saved."
            android:text="DONE" />

        <TextView
            android:id="@+id/btnSidebarReset"
            style="@style/SidebarEditHeaderChip"
            android:contentDescription="Put the sidebar back in MKTV's order with every entry shown"
            android:text="RESET TO DEFAULT" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSidebarItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
