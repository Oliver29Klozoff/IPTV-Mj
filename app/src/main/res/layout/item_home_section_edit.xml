<?xml version="1.0" encoding="utf-8"?>
<!-- One row of Home in Customize Home (HomeCustomizeActivity): a drag handle (touch screens), its
     name and what it shows, then Move up, Move down, Shown/Hidden and Edit. Every action is a
     button, so a remote can do everything a finger can. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@color/rack_surface"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvSectionHandle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="Drag to move"
        android:gravity="center"
        android:text="≡"
        android:textColor="@color/rack_text_secondary"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_semibold"
            android:maxLines="1"
            android:textColor="@color/rack_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSectionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rack_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSectionUp"
        style="@style/HomeEditChip"
        android:layout_width="48dp"
        android:text="▲" />

    <TextView
        android:id="@+id/btnSectionDown"
        style="@style/HomeEditChip"
        android:layout_width="48dp"
        android:text="▼" />

    <TextView
        android:id="@+id/btnSectionVisible"
        style="@style/HomeEditChip"
        android:layout_width="wrap_content"
        android:minWidth="96dp"
        android:paddingHorizontal="10dp" />

    <TextView
        android:id="@+id/btnSectionEdit"
        style="@style/HomeEditChip"
        android:layout_width="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="EDIT" />

</LinearLayout>
