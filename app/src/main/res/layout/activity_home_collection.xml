<?xml version="1.0" encoding="utf-8"?>
<!-- A row someone made, its items (HomeCollectionActivity): what is in it, in its order, with Move
     up / Move down / Remove; and a search to add more. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:theme="@style/ThemeOverlay.HomeRack">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCollectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_condensed_bold"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/rack_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnCollectionDone"
            style="@style/HomeEditHeaderChip"
            android:text="DONE" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCollectionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvCollectionInRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:letterSpacing="0.1"
        android:textColor="@color/rack_text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollectionItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvCollectionEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Nothing here yet. Search below and add some."
        android:textColor="@color/rack_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etCollectionSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rack_input_bg"
        android:hint="Search to add"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/rack_text"
        android:textColorHint="@color/rack_text_muted" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollectionResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
