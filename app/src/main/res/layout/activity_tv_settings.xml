<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#030810"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MKTV"
            android:textColor="#008CFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSettingsSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Settings"
            android:textColor="#CCCCCC"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSettingsSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:text="🔎 Find in Settings"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#008CFF"
            android:background="@drawable/tv_sidebar_focus"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/rvTvSettings" />

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0D1828" />

    <!-- Settings list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTvSettings"
        android:nextFocusUp="@id/btnSettingsSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

</LinearLayout>
