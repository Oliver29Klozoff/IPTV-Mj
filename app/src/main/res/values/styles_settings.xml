<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen styles: the "Studio Rack" layout (v6.80). Pure black, groups of dense rows,
     square toggles, segmented controls, Barlow / Barlow Condensed type, and ONE highlight color —
     the user's own accent pick — on every active or "on" state.

     Scope: activity_settings.xml, plus the settings_provider_btn_*.xml layouts SettingsActivity
     inflates for its Kotlin-built provider cards. Nothing else in the app uses these.

     How the accent gets in: resources can't hold a color picked at runtime, so anything that shows
     the accent carries an android:tag (set here, by its style), and SettingsActivity.applyRackAccent
     walks the view tree and colors each tagged view:
       accentFill    solid accent button              accentOutline  accent-outlined button
       accentIcon    grey button with an accent icon  accentText     text in the accent (values)
       accentDot     the status strip's provider dot  toggle         CheckBox drawn as a toggle
       segment       one option of a segmented control
     Switches and ProgressBars are found by type. When the accent is a gradient preset, fills,
     "on" toggles, chosen segments, the active tab, values and dots are drawn as a real gradient
     (outlined buttons and icons keep its first color), so those get drawables built in code. The
     XML colors and drawables are only what inflates (cyan, the app's default accent).

     D-pad focus (TV / car box) is the same everywhere: a lifted fill plus a light outline, never
     the accent, so focus stays visible on things that are already accent-colored.

     Wide screens (values-w840dp/) swap in a search field, the Quick bar's label and two extra
     status readouts; dimens_settings.xml has the rest of the phone / wide differences. -->
<resources>

    <style name="Rack" />

    <!-- ── Type ───────────────────────────────────────────────────────────────────────────── -->

    <!-- "SETTINGS" in the header. -->
    <style name="Rack.Title">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/rack_text</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Small condensed caps: readout labels, sub-headings inside a group. -->
    <style name="Rack.Eyebrow">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/rack_text_muted</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Title above a group box (GUIDE (EPG), PLAYBACK …). -->
    <style name="Rack.GroupTitle" parent="Rack.Eyebrow">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">@dimen/rack_inset</item>
        <item name="android:paddingEnd">@dimen/rack_inset</item>
    </style>

    <!-- A row's main line. -->
    <style name="Rack.Label">
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/rack_text</item>
    </style>

    <!-- The short explanation under a row's label. -->
    <style name="Rack.Helper">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/rack_text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- Status lines (Last refreshed …, ✓ Backup saved, speed test results). -->
    <style name="Rack.Note">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="fontFamily">@font/barlow_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/rack_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Current value on a tap-to-pick row ("5 min before", "Normal", "100%"), in the accent. -->
    <style name="Rack.Value">
        <item name="android:tag">accentText</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/oled_cyan_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:drawableEnd">@drawable/ic_settings_chevron_right</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/rack_chevron</item>
    </style>

    <!-- Same row when the value is a raw color code (#FFFFFFFF): grey, not the accent. -->
    <style name="Rack.Value.Code">
        <item name="android:tag">@null</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="fontFamily">@font/barlow_regular</item>
        <item name="android:textColor">@color/rack_text_secondary</item>
    </style>

    <!-- A status readout's value (12:37 AM, the provider name, 55,592, v6.80). -->
    <style name="Rack.ReadoutValue">
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/rack_text</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- ── Structure ──────────────────────────────────────────────────────────────────────── -->

    <!-- A panel (one per tab). -->
    <style name="Rack.Panel">
        <item name="android:descendantFocusability">afterDescendants</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>

    <!-- A panel's content: RackColumns, one column on phones, two on wide screens. -->
    <style name="Rack.Columns">
        <item name="android:paddingStart">@dimen/rack_page_padding</item>
        <item name="android:paddingEnd">@dimen/rack_page_padding</item>
        <item name="android:paddingBottom">28dp</item>
    </style>

    <!-- One group: its title, then its box. RackColumns moves the pair as a unit. -->
    <style name="Rack.Group">
        <item name="android:orientation">vertical</item>
    </style>

    <!-- The box of rows. Dividers are drawn by the box between visible rows only, so a row that
         SettingsActivity hides (DNS provider, Trakt buttons …) takes its line with it. -->
    <style name="Rack.GroupBox">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/rack_group_bg</item>
        <item name="android:divider">@drawable/rack_row_divider</item>
        <item name="android:showDividers">middle</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <!-- A disclosure row's expanded contents (a box inside the box). -->
    <style name="Rack.Nested" parent="Rack.GroupBox">
        <item name="android:background">@drawable/rack_recessed_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- Label column on the left, control on the right. -->
    <style name="Rack.Row">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/rack_row_min_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- A row that is itself the button: value rows, disclosure rows. -->
    <style name="Rack.Row.Tappable">
        <item name="android:background">@drawable/rack_row_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- A toggle row: the whole row is the D-pad / touch target and flips the toggle inside it
         (SettingsActivity.wireToggleRows); the toggle itself isn't a separate focus stop. -->
    <style name="Rack.Row.Toggle" parent="Rack.Row.Tappable">
        <item name="android:tag">toggleRow</item>
    </style>

    <!-- Label on top, a full-width control underneath (segments that need the room, text fields,
         pairs of buttons). -->
    <style name="Rack.Row.Stacked">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- The label + helper column of a row. -->
    <style name="Rack.RowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Disclosure-row chevron. wireCollapsible turns it to point up while the row is open. -->
    <style name="Rack.Chevron">
        <item name="android:drawableStart">@drawable/ic_settings_chevron_down</item>
        <item name="android:drawableTint">@color/rack_text_muted</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- ── Toggles, segments, fields ──────────────────────────────────────────────────────── -->

    <!-- android.widget.Switch. Not focusable or clickable on its own: its row is. -->
    <style name="Rack.Switch">
        <item name="android:thumb">@drawable/rack_switch_thumb</item>
        <item name="android:track">@drawable/rack_switch_track</item>
        <item name="android:background">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- SwitchMaterial, same look. useMaterialThemeColors off, or it re-tints the drawables with
         the theme's colors the moment it attaches. -->
    <style name="Rack.SwitchMaterial" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:thumb">@drawable/rack_switch_thumb</item>
        <item name="track">@drawable/rack_switch_track</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:background">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- A CheckBox drawn as the same toggle (rack_check_toggle). buttonCompat has to be set as
         well as android:button, because AppCompat applies buttonCompat first. -->
    <style name="Rack.CheckToggle" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:tag">toggle</item>
        <item name="android:button">@drawable/rack_check_toggle</item>
        <item name="buttonCompat">@drawable/rack_check_toggle</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:background">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- The outline around a segmented control. -->
    <style name="Rack.Segments">
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/rack_segment_group_bg</item>
        <item name="android:padding">2dp</item>
        <item name="android:divider">@drawable/rack_segment_gap</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- One option of a segmented control (a RadioButton). The chosen one's accent / gradient fill
         is drawn by SettingsActivity.rackSegmentBackground; rack_segment_bg is what inflates. -->
    <style name="Rack.Segment" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:tag">segment</item>
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:background">@drawable/rack_segment_bg</item>
        <item name="android:foreground">@drawable/rack_segment_focus</item>
        <item name="android:textColor">@color/rack_segment_text</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Rack.Input">
        <item name="android:background">@drawable/rack_input_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/rack_text</item>
        <item name="android:textColorHint">@color/rack_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="fontFamily">@font/barlow_regular</item>
    </style>

    <style name="Rack.Spinner">
        <item name="android:background">@drawable/rack_spinner_bg</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- ── Buttons (MaterialButton — every <Button> here inflates as one under this theme) ─── -->

    <style name="Rack.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">17dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Solid accent: the one main action of a group (Refresh, Back up, Push, Add provider …). -->
    <style name="Rack.Button.Primary">
        <item name="android:tag">accentFill</item>
        <item name="backgroundTint">@color/rack_btn_primary_bg</item>
        <item name="android:textColor">@color/rack_btn_primary_text</item>
        <item name="iconTint">@color/rack_btn_primary_text</item>
        <item name="strokeColor">@color/rack_btn_focus_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <!-- Accent outline: a second action next to a primary one, or a group's lone action. -->
    <style name="Rack.Button.Outline">
        <item name="android:tag">accentOutline</item>
        <item name="backgroundTint">@color/rack_btn_neutral_bg</item>
        <item name="android:textColor">@color/rack_btn_outline_text</item>
        <item name="iconTint">@color/rack_btn_outline_text</item>
        <item name="strokeColor">@color/rack_btn_outline_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- Grey outline: supporting actions (Cancel refresh, Edit, Saved codes …). -->
    <style name="Rack.Button.Neutral">
        <item name="backgroundTint">@color/rack_btn_neutral_bg</item>
        <item name="android:textColor">@color/rack_btn_text</item>
        <item name="iconTint">@color/rack_btn_text</item>
        <item name="strokeColor">@color/rack_btn_neutral_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- Grey outline with the icon in the accent (the Quick bar). -->
    <style name="Rack.Button.Neutral.AccentIcon">
        <item name="android:tag">accentIcon</item>
        <item name="iconTint">@color/rack_btn_outline_text</item>
    </style>

    <!-- Destructive (Log out, Remove, Clear, Disconnect). -->
    <style name="Rack.Button.Danger">
        <item name="backgroundTint">@color/rack_btn_danger_bg</item>
        <item name="android:textColor">@color/rack_btn_danger_text</item>
        <item name="iconTint">@color/rack_btn_danger_text</item>
        <item name="strokeColor">@color/rack_btn_danger_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FF6159</item>
    </style>

    <!-- A whole row that opens something (Provider health, What's new …): row-sized, label on the
         left in the row font, chevron on the right. -->
    <style name="Rack.Button.Link">
        <item name="backgroundTint">@color/rack_btn_neutral_bg</item>
        <item name="android:textColor">@color/rack_btn_text</item>
        <item name="strokeColor">@color/rack_btn_focus_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">@dimen/rack_row_min_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="icon">@drawable/ic_settings_chevron_right</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/rack_chevron</item>
    </style>

    <!-- Same row with a leading icon instead of the chevron (Quick actions). -->
    <style name="Rack.Button.Link.Leading">
        <item name="iconGravity">start</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">14dp</item>
        <item name="iconTint">@color/rack_text_secondary</item>
    </style>

    <!-- Header back / search / help: bare icon, outline only under D-pad focus. -->
    <style name="Rack.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/rack_text_secondary</item>
        <item name="cornerRadius">4dp</item>
        <item name="backgroundTint">@color/rack_btn_neutral_bg</item>
        <item name="strokeColor">@color/rack_btn_focus_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- Phones: the search icon. values-w840dp/ turns it into a search field. -->
    <style name="Rack.SearchButton" parent="Rack.IconButton">
        <item name="android:minWidth">44dp</item>
        <item name="icon">@drawable/ic_settings_search</item>
    </style>

    <!-- ── Tabs, readouts, Quick bar ──────────────────────────────────────────────────────── -->

    <!-- A panel tab. The active one gets the accent (text + a 2dp underline drawn as the button's
         foreground) from SettingsActivity.styleNavTab; this is the idle look. -->
    <style name="Rack.Tab" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/rack_tab_padding</item>
        <item name="android:paddingEnd">@dimen/rack_tab_padding</item>
        <item name="android:textColor">@color/rack_tab_text</item>
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">4dp</item>
        <item name="backgroundTint">@color/rack_btn_neutral_bg</item>
        <item name="strokeColor">@color/rack_btn_focus_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- Recordings opens its own screen instead of a panel — marked with a small ↗. -->
    <style name="Rack.Tab.Launcher">
        <item name="icon">@drawable/ic_settings_external</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconSize">12dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/rack_tab_text</item>
    </style>

    <!-- One cell of the status strip (label over value). -->
    <style name="Rack.Readout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/rack_readout_padding</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Cells that only fit on wide screens (CHANNELS, FORMAT); shown by values-w840dp/. -->
    <style name="Rack.Readout.WideOnly">
        <item name="android:visibility">gone</item>
    </style>

    <!-- The Quick bar's "QUICK" label — wide screens only (values-w840dp/). -->
    <style name="Rack.QuickLabel" parent="Rack.Eyebrow">
        <item name="android:letterSpacing">0.18</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>
