<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phone remote (v7.18) keys: plain TextViews on the Rack chip background. -->
    <style name="RemoteKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/home_chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/rack_text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
