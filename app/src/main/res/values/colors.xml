<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#0F0F0F</color>
    <color name="splash_background">#0F0F0F</color>
    <color name="brand_blue">#008CFF</color>
    <color name="brand_blue_dark">#005BFF</color>

    <!-- OLED Cyber-Stream palette — same tokens as ui/compose/theme/Color.kt, so the Compose UI
         Preview and this XML reskin read as one consistent design language instead of two.
         Currently used by the live-channel row (item_channel.xml / item_merged_channel.xml, both
         phone and TV) and the player's on-screen controls (activity_player.xml) — see
         focus_selector_channel.xml kdoc for why the shared app-wide focus_selector.xml was forked
         rather than retinted (it's also used by every VOD/Series row, which these tokens don't
         reach yet), and activity_player.xml's own top-of-file note for why tv_sidebar_focus and
         icon-button label colors weren't touched either. -->
    <color name="oled_cyan_primary">#06B6D4</color>
    <color name="oled_cyan_glow">#38BDF8</color>
    <!-- Deepest canvas tone — same value as Compose's SurfaceBackground, one tier below
         oled_surface_container_low (card surfaces), matching the depth system the Compose theme
         and the original Stitch mockups both used. Currently unused: Settings, its only user,
         moved to the rack_* palette below in v6.80. Kept as a palette token. -->
    <color name="oled_surface_background">#0A0E17</color>
    <!-- Sits between oled_surface_background and oled_surface_container_low ("elevated above the
         canvas but still distinct from card content"). Currently unused for the same reason. -->
    <color name="oled_surface_header">#0F131D</color>
    <color name="oled_surface_container_low">#161B26</color>
    <color name="oled_surface_container_highest">#283042</color>
    <color name="oled_outline_stroke">#2B3448</color>
    <color name="oled_text_primary">#F1F5F9</color>
    <color name="oled_text_secondary">#94A3B8</color>
    <color name="oled_text_muted">#64748B</color>
    <color name="oled_favorite_gold">#FBBF24</color>
    <color name="oled_live_badge_red">#EF4444</color>
    <!-- Low-alpha cyan wash for a static "subtle" surface. Currently unused: its only user was the
         Settings Speed Test button, which became a solid primary button in the v6.79 layout. Kept
         as a palette token. -->
    <color name="oled_cyan_wash">#1A06B6D4</color>

    <!-- Settings' "Studio Rack" palette (v6.80): pure black, neutral greys, and the user's own
         accent color for every highlight (applied at runtime by SettingsActivity.applyRackAccent,
         so none of these is an accent). Used by activity_settings.xml, styles_settings.xml, the
         rack_* drawables and SettingsActivity's Kotlin-built provider cards / accent picker only. -->
    <color name="rack_bg">#000000</color>
    <!-- A group of rows (the "module" in the rack). -->
    <color name="rack_surface">#0D0D0D</color>
    <!-- A disclosure row's expanded contents, recessed one step below the group they open inside. -->
    <color name="rack_surface_recessed">#070707</color>
    <color name="rack_footer">#050505</color>
    <color name="rack_border">#1F1F1F</color>
    <color name="rack_divider">#1A1A1A</color>
    <color name="rack_text">#EDEDED</color>
    <color name="rack_text_secondary">#A3A3A3</color>
    <!-- Helper lines and labels: ~5.6:1 on rack_surface, so small text stays readable. -->
    <color name="rack_text_muted">#8A8A8A</color>
    <color name="rack_chevron">#5C5C5C</color>
    <color name="rack_disabled_text">#5C5C5C</color>
    <!-- Controls in their "off" state (toggle track / edge / knob, idle segment border). -->
    <color name="rack_control_off">#1C1C1C</color>
    <color name="rack_control_edge">#333333</color>
    <color name="rack_knob_off">#7A7A7A</color>
    <!-- D-pad focus (TV / car box): a lifted fill plus a light outline. The outline is never the
         accent, so focus stays visible on things that are already accent-colored. -->
    <color name="rack_focus_fill">#1C1C1C</color>
    <color name="rack_focus_ring">#EDEDED</color>
    <color name="rack_pressed">#1A1A1A</color>
    <color name="rack_danger_text">#FF6159</color>
    <color name="rack_danger_bg">#140605</color>
    <color name="rack_danger_focus_bg">#2A0C0A</color>
    <color name="rack_danger_border">#4A1512</color>
    <color name="rack_danger_disabled_text">#6E3431</color>
</resources>
