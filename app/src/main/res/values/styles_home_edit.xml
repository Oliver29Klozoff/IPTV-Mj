<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Home (HomeCustomizeActivity, HomeCollectionActivity): the Rack look, with chips the
     remote can reach one by one. 48dp tall so a finger can hit them too. -->
<resources>
    <style name="HomeEditChip">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/player_chip_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/rack_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HomeEditHeaderChip" parent="HomeEditChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Customize Sidebar (TvSidebarCustomizeActivity): the same chips with a 3.5dp focus ring. -->
    <style name="SidebarEditChip" parent="HomeEditChip">
        <item name="android:background">@drawable/sidebar_edit_chip_bg</item>
    </style>

    <style name="SidebarEditHeaderChip" parent="HomeEditHeaderChip">
        <item name="android:background">@drawable/sidebar_edit_chip_bg</item>
    </style>

    <!-- Customize Home's Card Density & Size choices: a third of the row each, outlined when
         selected (activated) and ringed on remote focus, like the viewing style cards. -->
    <style name="DensityChip" parent="HomeEditChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/persona_card_bg</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Customize Home → Smart Rows dialog (dialog_smart_rows). -->
    <style name="SmartRowsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/rack_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SmartRowsNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/rack_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A rule switched with one press: the whole width, outlined while on. -->
    <style name="SmartRowsToggle" parent="HomeEditChip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/persona_card_bg</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
</resources>
