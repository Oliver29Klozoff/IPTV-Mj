<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rack_bg"
    android:theme="@style/ThemeOverlay.HomeRack">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/rack_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btnMenu" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/home_tab_bg"
            android:src="@android:drawable/ic_menu_sort_by_size" android:tint="#FFFFFF" />
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:text="MKTV"
            style="@style/HomeRack.Title" android:textSize="24sp" />
        <EditText android:id="@+id/etSearch" android:layout_width="240dp" android:layout_height="36dp"
            android:background="@drawable/home_search_bg" android:hint="Search..."
            android:textColorHint="#666666" android:textColor="#FFFFFF" android:textSize="14sp"
            android:paddingHorizontal="12dp" android:inputType="text" android:imeOptions="actionSearch"
            android:focusable="true" android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- STATUS STRIP (v6.84) — the Settings readout strip, live: active provider, its channel
         count, when the guide last refreshed and what is playing. Filled by
         HomeActivity.updateHomeStatusStrip. -->
    <LinearLayout
        android:id="@+id/homeStatusStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rack_strip_bg"
        android:divider="@drawable/rack_cell_divider"
        android:orientation="horizontal"
        android:showDividers="middle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">
        <LinearLayout
            style="@style/HomeRack.Readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <TextView
                style="@style/HomeRack.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Provider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- Accent dot, painted by HomeActivity.updateHomeStatusStrip. -->
                <View
                    android:id="@+id/homeStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:id="@+id/tvHomeStatusProvider"
                    style="@style/HomeRack.ReadoutValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            style="@style/HomeRack.Readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <TextView
                style="@style/HomeRack.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channels" />
            <TextView
                android:id="@+id/tvHomeStatusChannels"
                style="@style/HomeRack.ReadoutValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—" />
        </LinearLayout>
        <LinearLayout
            style="@style/HomeRack.Readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <TextView
                style="@style/HomeRack.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guide" />
            <TextView
                android:id="@+id/tvHomeStatusGuide"
                style="@style/HomeRack.ReadoutValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/homeStatusNowCell"
            style="@style/HomeRack.Readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            >
            <TextView
                style="@style/HomeRack.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now playing" />
            <TextView
                android:id="@+id/tvHomeStatusNow"
                style="@style/HomeRack.ReadoutValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—" />
        </LinearLayout>
    </LinearLayout>


    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/rack_tab_row_bg"
        app:tabTextAppearance="@style/HomeRack.TabText"
        app:tabTextColor="@color/rack_text_muted"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabIndicatorColor="@color/oled_cyan_primary"
        app:tabIndicatorHeight="2dp"
        app:tabMode="scrollable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeStatusStrip">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOVIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERIES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORY" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAVORITES" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GUIDE" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Main content area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <!-- Categories - left panel (weight 2 = ~25%) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:background="@color/rack_surface"
            android:paddingTop="8dp"
            android:focusable="true"
            android:nextFocusRight="@+id/rvChannels" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/rack_border" />

        <!-- Channels list - middle (weight 3 = ~37.5%) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:paddingTop="8dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/rvCategories"
            android:nextFocusRight="@+id/miniPlayerContainer" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/rack_border" />

        <!-- Mini player - right panel (weight 3 = ~37.5%) -->
        <FrameLayout
            android:id="@+id/miniPlayerContainer"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:background="#000000">
            <androidx.media3.ui.PlayerView
                android:id="@+id/miniPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#88000000"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:id="@+id/tvMiniChannelName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tvMiniEpg" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#AAAAAA"
                    android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnFullscreen" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="top|end" android:layout_margin="8dp"
                android:background="@drawable/home_tab_bg"
                android:src="@android:drawable/ic_menu_zoom" android:tint="#FFFFFF"
                android:focusable="true" />
            <ProgressBar android:id="@+id/miniPlayerProgress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:indeterminateTint="@color/oled_cyan_primary" android:visibility="gone" />
            <Button android:id="@+id/btnCollapsePip" android:layout_width="wrap_content"
                android:layout_height="28dp" android:layout_gravity="top|start" android:layout_margin="8dp"
                android:background="@android:color/transparent" android:text="PiP ▼"
                android:textColor="#AAAAAA" android:textSize="11sp" android:padding="4dp" />
        </FrameLayout>

    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone"
        android:indeterminateTint="@color/oled_cyan_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

    <FrameLayout
        android:id="@+id/pipCorner"
        android:layout_width="220dp"
        android:layout_height="130dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:background="#000000"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.media3.ui.PlayerView
            android:id="@+id/pipCornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />
        <TextView
            android:id="@+id/tvPipChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#88000000"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="4dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
